import { MatrixClient } from "matrix-js-sdk/src/matrix";

import { getE2EEWellKnown } from "../WellKnownUtils";

/**
 * Determines if well-known configuration forces encryption disabling for new 
rooms.
 *
 * This helper inspects the client's .well-known E2EE configuration and answers 
whether
 * encryption is explicitly forced off by policy. Server-level "force enabled" 
settings
 * are resolved elsewhere (e.g., by higher-level logic); this helper is 
concerned strictly
 * with the .well-known "force disabled" policy.
 *
 * @param client The Matrix Client instance
 * @returns true if the force_disable flag is present and set to true; false 
otherwise
 */
export function shouldForceDisableEncryption(client: MatrixClient): boolean {
    const e2eeWellKnown = getE2EEWellKnown(client);
    if (!e2eeWellKnown) {
        return false;
    }
    return e2eeWellKnown.force_disable === true;
}

=== createRoom.ts (imports and function) ===
import { shouldForceDisableEncryption } from 
"./utils/room/shouldForceDisableEncryption";
export interface AllowedEncryptionSetting {
    allowChange: boolean;
    forcedValue?: boolean;
}

/**
 * Checks if the user can change encryption configuration based on server and 
well-known configurations.
 *
 * This helper evaluates both sources of truth: the server-side policy (via the 
client's
 * "does server force encryption for this preset?" capability) and the 
.well-known policy.
 * When policies conflict, the helper prefers the server policy and emits a 
concise warning
 * to the console to aid diagnosis.
 *
 * @param client The Matrix Client instance
 * @param chatPreset The room preset (e.g., PrivateChat, TrustedPrivateChat)
 * @returns A promise resolving to an object indicating whether encryption can 
be changed
 *          and, if not, what value is forced
 */
export async function checkUserIsAllowedToChangeEncryption(
    client: MatrixClient,
    chatPreset: Preset,
): Promise<AllowedEncryptionSetting> {
    // Check server-side policy first
    const serverForcesEncryption = await 
client.doesServerForceEncryptionForPreset(chatPreset);
    if (serverForcesEncryption) {
        return {
            allowChange: false,
            forcedValue: true,
        };
    }

    // Check well-known policy
    const wellKnownForcesDisable = shouldForceDisableEncryption(client);
    if (wellKnownForcesDisable) {
        return {
            allowChange: false,
            forcedValue: false,
        };
    }

    // Neither policy forces a value
    return {
        allowChange: true,
    };
}

