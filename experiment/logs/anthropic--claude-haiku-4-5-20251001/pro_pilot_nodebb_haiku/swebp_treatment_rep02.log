const newFunction = `   async function getConfirmObjs() {
                // Get confirmation codes for all users
                const confirmCodes = await db.mget(uids.map(uid => 
\`confirm:byUid:\${uid}\`));
                
                // Build a map of indices to confirmation keys
                const confirmKeysWithIndices = confirmCodes
                        .map((code, index) => code ? { index, key: 
\`confirm:\${code}\` } : null)
                        .filter(item => item !== null);
                
                // Get confirmation objects for all codes
                const confirmKeys = confirmKeysWithIndices.map(item => 
item.key);
                const confirmObjsData = confirmKeys.length > 0 ? await 
db.getObjects(confirmKeys) : [];
                
                // Map confirmation objects back to users by index
                const confirmObjs = new Array(uids.length).fill(null);
                confirmKeysWithIndices.forEach((item, dataIndex) => {
                        confirmObjs[item.index] = confirmObjsData[dataIndex];
                });
                
                return confirmObjs;
        }`;

content = content.replace(oldFunction, newFunction);

fs.writeFileSync(filePath, content);
console.log('Fixed getConfirmObjs in admin/users.js');
EOF
