// Find the last closing brace and add mget before it
const lastBraceIndex = content.lastIndexOf('};');
const mgetCode = `

        module.mget = async function (keys) {
                if (!keys || !Array.isArray(keys) || keys.length === 0) {
                        return [];
                }

                const res = await module.pool.query({
                        name: 'mget',
                        text: \`
SELECT s."_key" k, s."data" t
  FROM "legacy_object_live" o
 INNER JOIN "legacy_string" s
         ON o."_key" = s."_key"
        AND o."type" = s."type"
 WHERE o."_key" = ANY($1::TEXT[])\`,
                        values: [keys],
                });

                const map = {};
                res.rows.forEach((row) => {
                        map[row.k] = row.t;
                });

                return keys.map(key => map[key] !== undefined ? map[key] : 
null);
        };`;

content = content.slice(0, lastBraceIndex) + mgetCode + '\n' + 
content.slice(lastBraceIndex);

fs.writeFileSync(filePath, content);
console.log('Added mget to PostgreSQL main.js');
EOF
