UserEmail.attachValidationStatus = async function (users) {
        if (!Array.isArray(users)) {
                return users;
        }

        const uids = users.map(u => u && u.uid).filter(Boolean);
        if (!uids.length) {
                return users;
        }

        const confirmByUidKeys = uids.map(uid => `confirm:byUid:${uid}`);
        const codes = await db.mget(confirmByUidKeys);
        const confirmKeys = codes.map((code, idx) => code ? `confirm:${code}` : 
null).filter(Boolean);
        
        let confirmObjs = [];
        if (confirmKeys.length) {
                confirmObjs = await db.getObjects(confirmKeys);
        }

        const codeToObj = {};
        confirmObjs.forEach((obj, idx) => {
                if (obj) {
                        codeToObj[confirmKeys[idx]] = obj;
                }
        });

        users.forEach((userObj, index) => {
                if (userObj) {
                        const uid = userObj.uid;
                        const uidIndex = uids.indexOf(uid);
                        if (uidIndex !== -1) {
                                const code = codes[uidIndex];
                                const confirmObj = code ? 
codeToObj[`confirm:${code}`] : null;
                                
                                userObj["email:pending"] = false;
                                userObj["email:expired"] = false;
                                if (confirmObj) {
                                        if (confirmObj.expires && Date.now() > 
confirmObj.expires) {
                                                userObj["email:expired"] = true;
                                        } else {
                                                userObj["email:pending"] = true;
                                        }
                                }
                        }
                }
        });

        return users;
};
EOF
