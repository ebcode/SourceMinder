                        const timestamp = lastonline[index] || userObj.joindate;
                        userObj.lastonline = timestamp;
                        userObj.lastonlineISO = utils.toISOString(timestamp);
                        userObj.ips = ips[index];
                        userObj.ip = ips[index] && ips[index][0] ? ips[index][0]
: null;

                        const confirmObj = confirmObjs[index];
                        if (confirmObj) {
                                if (confirmObj.expires && Date.now() > 
confirmObj.expires) {
                                        userObj["email:expired"] = true;
                                } else {
                                        userObj["email:pending"] = true;
                                }
                        }
                }
        });
        return userData;
