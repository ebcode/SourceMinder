                uid = await user.create({
                        username: utils.generateUUID().slice(0, 10),
                        password: utils.generateUUID(),
                });
        });

        after(async () => {
                plugins.hooks.unregister('emailer-test', 'filter:email.send');
        });

        describe('isValidationPending', () => {
