                        await user.email.sendValidationEmail(uid, {
                                email,
                        });
                        const pending = await 
user.email.isValidationPending(uid, email);

                        assert.strictEqual(pending, true);
                });
        });

        describe('getValidationExpiry', () => {
                it('should return null if there is no validation available', 
async () => {
                        const expiry = await 
user.email.getValidationExpiry(uid);

                        assert.strictEqual(expiry, null);
                });

