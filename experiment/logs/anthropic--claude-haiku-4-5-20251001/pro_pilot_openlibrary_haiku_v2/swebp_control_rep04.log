    def _get_wikipedia_link(self, language: str = 'en') -> tuple[str, str] | 
None:
        """
        Get the Wikipedia link for the entity in the requested language.
        Falls back to English if the requested language is not available.
        Returns a tuple of (url, language) or None if no Wikipedia link exists.
        """
        # Try to get the link in the requested language
        lang_code = f'{language}wiki'
        if lang_code in self.sitelinks:
            return (self.sitelinks[lang_code]['url'], language)
        
        # Fall back to English
        if language != 'en' and 'enwiki' in self.sitelinks:
            return (self.sitelinks['enwiki']['url'], 'en')
        
        # No Wikipedia link available
        return None

    def _get_statement_values(self, property_id: str) -> list[str]:
        """
        Get the values for a Wikidata property.
        Returns a list of values, handling single values, multiple values,
        missing properties, and malformed entries.
        """
        if property_id not in self.statements:
            return []
        
        values = []
        for statement in self.statements[property_id]:
            try:
                # Extract the content from the statement
                if 'value' in statement and 'content' in statement['value']:
                    values.append(statement['value']['content'])
            except (KeyError, TypeError):
                # Skip malformed entries
                continue
        
        return values

    def get_external_profiles(self, language: str = 'en') -> list[dict]:
        """
        Get a structured list of external profiles for the entity.
        Each item includes 'url', 'icon_url', and 'label' keys.
        Includes Wikipedia (if available), Wikidata, and external identifiers.
        """
        profiles = []
        
        # Add Wikipedia profile if available
        wikipedia_link = self._get_wikipedia_link(language)
        if wikipedia_link:
            profiles.append({
                'url': wikipedia_link[0],
                'icon_url': '/static/images/identifier_icons/wikipedia.svg',
                'label': 'Wikipedia',
            })
        
        # Add Wikidata profile (always)
        profiles.append({
            'url': f'https://www.wikidata.org/wiki/{self.id}',
            'icon_url': '/static/images/identifier_icons/wikidata.svg',
            'label': 'Wikidata',
