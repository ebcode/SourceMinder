# Read the original file
with open('/app/openlibrary/core/wikidata.py', 'r') as f:
    lines = f.readlines()

# Find the line number where we need to insert (after get_description method)
insert_line = None
for i, line in enumerate(lines):
    if 'def get_description(self, language: str' in line:
        # Find the end of this method (next line that starts with 'def' or '@')
        for j in range(i+1, len(lines)):
            if lines[j].strip() and not lines[j].startswith(' ' * 8) and 
(lines[j].strip().startswith('def ') or lines[j].strip().startswith('@')):
