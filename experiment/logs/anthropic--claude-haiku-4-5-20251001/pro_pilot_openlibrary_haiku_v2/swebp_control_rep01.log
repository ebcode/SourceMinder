    'enwiki': {'url': 'https://en.wikipedia.org/wiki/Test'},
    'eswiki': {'url': 'https://es.wikipedia.org/wiki/Test'}
}
entity.statements = {
    'P1960': [
        {'value': {'content': 'scholar1'}},
        {'value': {'content': 'scholar2'}}
    ]
}

# Wikipedia link in requested language
