# _get_statement_values signature
sig = inspect.signature(entity._get_statement_values)
print(f"   _get_statement_values: {sig}")
assert 'property_id' in sig.parameters
print("   ✓ Correct signature")

# get_external_profiles signature
sig = inspect.signature(entity.get_external_profiles)
