('https://en.wikipedia.org/wiki/Test', 'en')
    assert entity._get_wikipedia_link('es') == 
('https://es.wikipedia.org/wiki/Test', 'es')
    print("✓ Test 3 passed: English fallback")
    
    # Test 4: _get_statement_values with empty statements
    entity.statements = {}
    assert entity._get_statement_values('P1960') == []
    print("✓ Test 4 passed: Empty statements")
    
    # Test 5: _get_statement_values with malformed entries
    entity.statements = {
        'P1960': [
            {'value': {'content': 'valid1'}},
            {'no_value': {}},
            {'value': {}},
            {'value': {'content': 'valid2'}},
            {},
        ]
    }
    assert entity._get_statement_values('P1960') == ['valid1', 'valid2']
    print("✓ Test 5 passed: Malformed entries")
    
    # Test 6: get_external_profiles with no Wikipedia link
