assert result == ('https://es.wikipedia.org/wiki/Test', 'es')
print("   ✓ Wikipedia link in requested language works")

# Wikipedia link fallback to English
result = entity._get_wikipedia_link('fr')
assert result == ('https://en.wikipedia.org/wiki/Test', 'en')
print("   ✓ Wikipedia link fallback to English works")

# Statement values extraction
result = entity._get_statement_values('P1960')
assert result == ['scholar1', 'scholar2']
print("   ✓ Statement values extraction works")

# External profiles generation
