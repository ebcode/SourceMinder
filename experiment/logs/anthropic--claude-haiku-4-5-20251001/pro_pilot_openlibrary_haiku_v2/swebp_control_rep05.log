    def _get_wikipedia_link(self, language: str = 'en') -> tuple[str, str] | 
None:
        """
        Get the Wikipedia link for the entity in the requested language.
        Falls back to English if the requested language is not available.
        Returns a tuple of (url, language) or None if no Wikipedia link exists.
        """
        # Try to get the link in the requested language
        sitelink_key = f'{language}wiki'
        if sitelink_key in self.sitelinks:
            url = self.sitelinks[sitelink_key].get('url')
            if url:
                return (url, language)
        
        # Fall back to English if requested language is not available
        if language != 'en':
            sitelink_key = 'enwiki'
            if sitelink_key in self.sitelinks:
                url = self.sitelinks[sitelink_key].get('url')
                if url:
                    return (url, 'en')
        
        # No Wikipedia link found
        return None

    def _get_statement_values(self, property_id: str) -> list[str]:
        """
        Get the values for a Wikidata property.
        Returns a list of values, handling single values, multiple values,
        missing properties, and malformed entries.
        """
        if property_id not in self.statements:
            return []
        
        values = []
        statements = self.statements[property_id]
        
        # Handle both list and dict formats
        if not isinstance(statements, list):
            statements = [statements]
        
        for statement in statements:
            try:
                # Extract the value from the statement
                if isinstance(statement, dict) and 'value' in statement:
                    value_obj = statement['value']
                    if isinstance(value_obj, dict) and 'content' in value_obj:
                        content = value_obj['content']
                        if content:  # Only add non-empty values
                            values.append(content)
            except (KeyError, TypeError, AttributeError):
                # Skip malformed entries
                continue
        
        return values

    def get_external_profiles(self, language: str = 'en') -> list[dict]:
        """
        Get a structured list of external profiles for the entity.
        Returns a list of dicts with keys: url, icon_url, label.
        Includes Wikipedia (if available), Wikidata, and other external 
identifiers.
        """
        profiles = []
        
        # Add Wikipedia profile if available
        wikipedia_link = self._get_wikipedia_link(language)
        if wikipedia_link:
            url, _ = wikipedia_link
            profiles.append({
                'url': url,
                'icon_url': '/static/images/identifier_icons/wikipedia.svg',
                'label': 'Wikipedia',
