#!/usr/bin/env python3
"""Test script to verify the implementation of the new methods."""

import sys
sys.path.insert(0, '/app')

from openlibrary.core.wikidata import WikidataEntity
from datetime import datetime

def test_get_wikipedia_link():
    """Test the _get_wikipedia_link method."""
    print("Testing _get_wikipedia_link...")
    
    # Test 1: Both English and Spanish links available
    entity = WikidataEntity(
        id='Q42',
        type='item',
        labels={'en': 'Test'},
        descriptions={'en': 'Test description'},
        aliases={},
        statements={},
        sitelinks={
            'enwiki': {'url': 'https://en.wikipedia.org/wiki/Example'},
            'eswiki': {'url': 'https://es.wikipedia.org/wiki/Ejemplo'},
        },
        _updated=datetime.now()
    )
    
    result = entity._get_wikipedia_link('es')
    assert result == ('https://es.wikipedia.org/wiki/Ejemplo', 'es'), f"Expected
Spanish link, got {result}"
    print("✓ Spanish link found")
    
    result = entity._get_wikipedia_link('en')
    assert result == ('https://en.wikipedia.org/wiki/Example', 'en'), f"Expected
English link, got {result}"
    print("✓ English link found")
    
    # Test 2: Fallback to English when requested language unavailable
    result = entity._get_wikipedia_link('fr')
    assert result == ('https://en.wikipedia.org/wiki/Example', 'en'), f"Expected
fallback to English, got {result}"
    print("✓ Fallback to English works")
    
    # Test 3: No links available
    entity_no_links = WikidataEntity(
        id='Q42',
        type='item',
        labels={'en': 'Test'},
        descriptions={'en': 'Test description'},
        aliases={},
        statements={},
        sitelinks={},
        _updated=datetime.now()
    )
    result = entity_no_links._get_wikipedia_link()
    assert result is None, f"Expected None, got {result}"
    print("✓ No links returns None")
    
    print("✓ _get_wikipedia_link tests passed!\n")

def test_get_statement_values():
    """Test the _get_statement_values method."""
    print("Testing _get_statement_values...")
    
    entity = WikidataEntity(
        id='Q42',
        type='item',
        labels={'en': 'Test'},
        descriptions={'en': 'Test description'},
        aliases={},
        statements={
            'P2038': [{'value': {'content': 'Chris-Wiggins'}}]
        },
        sitelinks={},
        _updated=datetime.now()
    )
    
    # Test 1: Single value
    result = entity._get_statement_values('P2038')
    assert result == ['Chris-Wiggins'], f"Expected ['Chris-Wiggins'], got 
{result}"
    print("✓ Single value extraction works")
    
    # Test 2: Multiple values
    entity.statements = {
        'P2038': [
            {'value': {'content': 'Value1'}},
            {'value': {'content': 'Value2'}},
            {'value': {'content': 'Value3'}},
        ]
    }
    result = entity._get_statement_values('P2038')
    assert result == ['Value1', 'Value2', 'Value3'], f"Expected ['Value1', 
'Value2', 'Value3'], got {result}"
    print("✓ Multiple values extraction works")
    
    # Test 3: Missing property
    result = entity._get_statement_values('P9999')
    assert result == [], f"Expected [], got {result}"
    print("✓ Missing property returns empty list")
    
    # Test 4: Malformed statements
    entity.statements = {
        'P2038': [
            {'value': {'content': 'Valid'}},
            {'wrong_key': {}},  # Missing 'value'
            {'value': {}},  # Missing 'content'
        ]
    }
    result = entity._get_statement_values('P2038')
    assert result == ['Valid'], f"Expected ['Valid'], got {result}"
    print("✓ Malformed entries are skipped")
    
    print("✓ _get_statement_values tests passed!\n")

def test_get_external_profiles():
    """Test the get_external_profiles method."""
    print("Testing get_external_profiles...")
    
    entity = WikidataEntity(
        id='Q42',
        type='item',
        labels={'en': 'Test'},
        descriptions={'en': 'Test description'},
        aliases={},
        statements={
            'P1960': [{'value': {'content': 'scholar123'}}]
        },
        sitelinks={
            'enwiki': {'url': 'https://en.wikipedia.org/wiki/Example'},
        },
        _updated=datetime.now()
    )
    
    profiles = entity.get_external_profiles('en')
    
    # Should have 3 profiles: Wikipedia, Wikidata, Google Scholar
    assert len(profiles) == 3, f"Expected 3 profiles, got {len(profiles)}"
    print(f"✓ Got {len(profiles)} profiles")
    
    # Check Wikipedia profile
    wiki_profile = next((p for p in profiles if p['label'] == 'Wikipedia'), 
None)
    assert wiki_profile is not None, "Wikipedia profile not found"
    assert wiki_profile['url'] == 'https://en.wikipedia.org/wiki/Example'
    assert wiki_profile['icon_url'] == 
'/static/images/identifier_icons/wikipedia.svg'
    print("✓ Wikipedia profile is correct")
    
    # Check Wikidata profile
    wikidata_profile = next((p for p in profiles if p['label'] == 'Wikidata'), 
None)
    assert wikidata_profile is not None, "Wikidata profile not found"
    assert wikidata_profile['url'] == 'https://www.wikidata.org/wiki/Q42'
    assert wikidata_profile['icon_url'] == 
'/static/images/identifier_icons/wikidata.svg'
    print("✓ Wikidata profile is correct")
    
    # Check Google Scholar profile
    scholar_profile = next((p for p in profiles if p['label'] == 'Google 
Scholar'), None)
    assert scholar_profile is not None, "Google Scholar profile not found"
    assert scholar_profile['url'] == 
'https://scholar.google.com/citations?user=scholar123'
    assert scholar_profile['icon_url'] == 
'/static/images/identifier_icons/google_scholar.svg'
    print("✓ Google Scholar profile is correct")
    
    print("✓ get_external_profiles tests passed!\n")

def test_get_external_profiles_multiple():
    """Test get_external_profiles with multiple identifiers."""
    print("Testing get_external_profiles with multiple identifiers...")
    
    entity = WikidataEntity(
        id='Q42',
        type='item',
        labels={'en': 'Test'},
        descriptions={'en': 'Test description'},
        aliases={},
        statements={
            'P1960': [
                {'value': {'content': 'scholar123'}},
                {'value': {'content': 'scholar456'}},
            ]
        },
        sitelinks={},
        _updated=datetime.now()
    )
    
    profiles = entity.get_external_profiles('en')
    
    # Should have 3 profiles: 2 Google Scholar + 1 Wikidata (no Wikipedia)
    assert len(profiles) == 3, f"Expected 3 profiles, got {len(profiles)}"
    print(f"✓ Got {len(profiles)} profiles")
    
    # Check Google Scholar profiles
    scholar_profiles = [p for p in profiles if p['label'] == 'Google Scholar']
    assert len(scholar_profiles) == 2, f"Expected 2 Google Scholar profiles, got
{len(scholar_profiles)}"
    print("✓ Got 2 Google Scholar profiles")
    
    scholar_urls = {p['url'] for p in scholar_profiles}
    expected_urls = {
        'https://scholar.google.com/citations?user=scholar123',
        'https://scholar.google.com/citations?user=scholar456',
    }
    assert scholar_urls == expected_urls, f"Expected {expected_urls}, got 
{scholar_urls}"
    print("✓ Google Scholar URLs are correct")
    
    print("✓ get_external_profiles with multiple identifiers tests passed!\n")

if __name__ == '__main__':
    test_get_wikipedia_link()
    test_get_statement_values()
    test_get_external_profiles()
    test_get_external_profiles_multiple()
    print("✅ All tests passed!")
