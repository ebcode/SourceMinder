                                Version:    "1.0.0",
                                Release:    "a",
                                NewVersion: "1.0.1",
                                NewRelease: "b",
                        },
                        args: args{
                                stat: PackageFixStatus{
                                        NotFixedYet: false,
                                        FixedIn:     "1.0.1-b",
                                },
                        },
                        want: "packA-1.0.0-a -> 1.0.1-b (FixedIn: 1.0.1-b)",
                },
                {
                        name: "nfy",
                        fields: fields{
