func (l *base) parseLsOf(stdout string) map[string]string {
        portPid := map[string]string{}
        scanner := bufio.NewScanner(strings.NewReader(stdout))
        for scanner.Scan() {
                ss := strings.Fields(scanner.Text())
                if len(ss) < 10 {
                        continue
                }
                pid, ipPort := ss[1], ss[8]
                portPid[ipPort] = pid
        }
        return portPid
}

// parseListenPorts parses an endpoint string into a ListenPort struct
// Supports formats: "127.0.0.1:22", "*:80", "[::1]:443"
