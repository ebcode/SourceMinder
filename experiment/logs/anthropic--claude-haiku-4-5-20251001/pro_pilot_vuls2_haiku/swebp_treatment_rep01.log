// detectScanDest returns a deduplicated slice of "ip:port" strings from 
affected processes
func (l *base) detectScanDest() []string {
        destMap := make(map[string]bool)
        var result []string

        for _, pkg := range l.osPackages.Packages {
                for _, proc := range pkg.AffectedProcs {
                        for _, listenPort := range proc.ListenPorts {
                                if listenPort.Address == "" || listenPort.Port 
== "" {
                                        continue
                                }

                                if listenPort.Address == "*" {
                                        // Expand "*" to all IPv4 addresses
                                        for _, ipAddr := range 
l.ServerInfo.IPv4Addrs {
                                                dest := fmt.Sprintf("%s:%s", 
ipAddr, listenPort.Port)
                                                if !destMap[dest] {
                                                        destMap[dest] = true
                                                        result = append(result, 
dest)
                                                }
                                        }
                                } else {
                                        dest := fmt.Sprintf("%s:%s", 
listenPort.Address, listenPort.Port)
                                        if !destMap[dest] {
                                                destMap[dest] = true
                                                result = append(result, dest)
                                        }
                                }
                        }
                }
        }

        return result
}

// parseListenPorts parses an endpoint string into a ListenPort struct
// Supports formats: "127.0.0.1:22", "*:80", "[::1]:443"
func (l *base) parseListenPorts(s string) models.ListenPort {
        if s == "" {
                return models.ListenPort{}
        }

        // Handle IPv6 addresses in brackets
        if strings.HasPrefix(s, "[") {
                // Find the closing bracket
                closingIdx := strings.Index(s, "]")
                if closingIdx == -1 {
                        return models.ListenPort{}
                }
                // Extract address with brackets and port
                address := s[:closingIdx+1]
                port := ""
                if closingIdx+1 < len(s) && s[closingIdx+1] == ':' {
                        port = s[closingIdx+2:]
                }
                return models.ListenPort{
                        Address: address,
                        Port:    port,
                }
        }

        // For non-IPv6 addresses, split on the last colon
        lastColonIdx := strings.LastIndex(s, ":")
        if lastColonIdx == -1 {
                return models.ListenPort{}
        }

        address := s[:lastColonIdx]
        port := s[lastColonIdx+1:]

        return models.ListenPort{
                Address: address,
                Port:    port,
        }
}

// findPortScanSuccessOn returns a list of IPv4 addresses where the port was 
confirmed open
// Always returns a non-nil slice ([]string{} when empty)
func (l *base) findPortScanSuccessOn(listenIPPorts []string, searchListenPort 
models.ListenPort) []string {
        if searchListenPort.Port == "" {
                return []string{}
        }

        var result []string
        resultMap := make(map[string]bool)

        for _, ipPort := range listenIPPorts {
                // Parse the ipPort string
                lastColonIdx := strings.LastIndex(ipPort, ":")
                if lastColonIdx == -1 {
                        continue
                }

                scanIP := ipPort[:lastColonIdx]
                scanPort := ipPort[lastColonIdx+1:]

                // Check if port matches
                if scanPort != searchListenPort.Port {
                        continue
                }

                // Check if address matches
                if searchListenPort.Address == "*" {
                        // Wildcard matches any IP
                        if !resultMap[scanIP] {
                                resultMap[scanIP] = true
                                result = append(result, scanIP)
                        }
                } else if searchListenPort.Address == scanIP {
                        // Exact match
                        if !resultMap[scanIP] {
                                resultMap[scanIP] = true
                                result = append(result, scanIP)
                        }
                }
        }

        return result
}

// updatePortStatus updates PortScanSuccessOn in place inside 
l.osPackages.Packages
func (l *base) updatePortStatus(listenIPPorts []string) {
        for pkgName, pkg := range l.osPackages.Packages {
                for procIdx, proc := range pkg.AffectedProcs {
                        for portIdx, listenPort := range proc.ListenPorts {
                                successOn := 
l.findPortScanSuccessOn(listenIPPorts, listenPort)
                                pkg.AffectedProcs[procIdx].ListenPorts[portIdx].
PortScanSuccessOn = successOn
                        }
                }
                l.osPackages.Packages[pkgName] = pkg
        }
}
EOF
