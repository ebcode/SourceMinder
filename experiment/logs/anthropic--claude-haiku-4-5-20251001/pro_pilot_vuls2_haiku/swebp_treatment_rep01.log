// findPortScanSuccessOn returns a list of IPv4 addresses where the port was 
confirmed open
// Always returns a non-nil slice ([]string{} when empty)
func (l *base) findPortScanSuccessOn(listenIPPorts []string, searchListenPort 
models.ListenPort) []string {
        if searchListenPort.Port == "" {
                return []string{}
        }

        result := []string{}  // Initialize as empty slice instead of nil
        resultMap := make(map[string]bool)

        for _, ipPort := range listenIPPorts {
                // Parse the ipPort string
                lastColonIdx := strings.LastIndex(ipPort, ":")
                if lastColonIdx == -1 {
                        continue
                }

                scanIP := ipPort[:lastColonIdx]
                scanPort := ipPort[lastColonIdx+1:]

                // Check if port matches
                if scanPort != searchListenPort.Port {
                        continue
                }

                // Check if address matches
                if searchListenPort.Address == "*" {
                        // Wildcard matches any IP
                        if !resultMap[scanIP] {
                                resultMap[scanIP] = true
                                result = append(result, scanIP)
                        }
                } else if searchListenPort.Address == scanIP {
                        // Exact match
                        if !resultMap[scanIP] {
                                resultMap[scanIP] = true
                                result = append(result, scanIP)
                        }
                }
        }

        return result
}
