func (o *redhatBase) rpmQa(distro config.Distro) string {
        const old = `rpm -qa --queryformat "%{NAME} %{EPOCH} %{VERSION} 
%{RELEASE} %{ARCH}\n"`
        const new = `rpm -qa --queryformat "%{NAME} %{EPOCHNUM} %{VERSION} 
%{RELEASE} %{ARCH}\n"`
        switch distro.Family {
        case config.SUSEEnterpriseServer:
                if v, _ := distro.MajorVersion(); v < 12 {
                        return old
                }
                return new
        default:
                if v, _ := distro.MajorVersion(); v < 6 {
                        return old
                }
                return new
        }
}

func (o *redhatBase) rpmQf(distro config.Distro) string {
        const old = `rpm -qf --queryformat "%{NAME} %{EPOCH} %{VERSION} 
%{RELEASE} %{ARCH}\n" `
        const new = `rpm -qf --queryformat "%{NAME} %{EPOCHNUM} %{VERSION} 
%{RELEASE} %{ARCH}\n" `
        switch distro.Family {
        case config.SUSEEnterpriseServer:
                if v, _ := distro.MajorVersion(); v < 12 {
                        return old
                }
                return new
        default:
                if v, _ := distro.MajorVersion(); v < 6 {
                        return old
                }
                return new
        }
}
