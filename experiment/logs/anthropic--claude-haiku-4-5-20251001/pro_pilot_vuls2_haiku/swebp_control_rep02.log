func TestParseDockerPs(t *testing.T) {
        var test = struct {
                in       string
                expected []config.Container
        }{
                `c7ca0992415a romantic_goldberg ubuntu:14.04.5
f570ae647edc agitated_lovelace centos:latest`,
                []config.Container{
