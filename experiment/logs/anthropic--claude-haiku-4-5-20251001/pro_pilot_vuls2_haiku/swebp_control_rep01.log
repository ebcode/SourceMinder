        if searchListenPort.Port == "" {
                return []string{}
        }

        var result []string
        resultMap := make(map[string]bool)

        for _, ipPort := range listenIPPorts {
                // Parse the ip:port string
                lastColonIdx := strings.LastIndex(ipPort, ":")
                if lastColonIdx == -1 {
                        continue
                }

                ip := ipPort[:lastColonIdx]
                port := ipPort[lastColonIdx+1:]

                // Check if port matches
                if port != searchListenPort.Port {
                        continue
                }

                // Check if address matches
                if searchListenPort.Address == "*" {
                        // Wildcard matches any IP
                        if !resultMap[ip] {
                                resultMap[ip] = true
                                result = append(result, ip)
                        }
                } else if searchListenPort.Address == ip {
                        // Exact match
                        if !resultMap[ip] {
                                resultMap[ip] = true
                                result = append(result, ip)
                        }
                }
