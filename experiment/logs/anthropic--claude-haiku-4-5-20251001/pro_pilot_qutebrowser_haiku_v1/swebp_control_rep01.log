    with qtlog.hide_qt_warning("test", 'test-comprehensive'):
        pass
    print("   ✓ hide_qt_warning context manager works")
except Exception as e:
    print(f"   ✗ Error: {e}")

# Requirement 2: Warning messages that do not contain the specified filter 
pattern 
