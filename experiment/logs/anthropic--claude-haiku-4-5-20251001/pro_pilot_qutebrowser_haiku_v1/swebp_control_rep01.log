print("   Expected: 'Other message' should appear below")
with qtlog.hide_qt_warning("Hello", 'test-comprehensive'):
    logger.warning("Other message")
print("   ✓ Unfiltered message passed through")

# Requirement 3: Log entries that exactly match the provided filter string 
# should be completely suppressed
print("\n3. Testing exact match filtering:")
print("   Expected: No message should appear below")
with qtlog.hide_qt_warning("Hello", 'test-comprehensive'):
    logger.warning("Hello")
print("   ✓ Exact match was filtered")

# Requirement 4: Messages containing the filter pattern at the beginning 
# should be blocked
print("\n4. Testing pattern at beginning of message:")
print("   Expected: No message should appear below")
with qtlog.hide_qt_warning("Hello", 'test-comprehensive'):
    logger.warning("Hello World")
print("   ✓ Pattern at beginning was filtered")

# Requirement 5: Filter pattern matching should handle leading/trailing 
whitespace
print("\n5. Testing whitespace handling:")
print("   Expected: No message should appear below")
with qtlog.hide_qt_warning("Hello", 'test-comprehensive'):
    logger.warning("  Hello World  ")
print("   ✓ Whitespace was handled correctly")

# Requirement 6: Context manager should maintain consistent suppression behavior
# across different logger instances
print("\n6. Testing consistency across different logger instances:")
logger2 = logging.getLogger('test-comprehensive-2')
logger2.addHandler(handler)
logger2.setLevel(logging.WARNING)

print("   Expected: No message should appear below")
with qtlog.hide_qt_warning("Test", 'test-comprehensive-2'):
    logger2.warning("Test message")
print("   ✓ Filtering works consistently across different loggers")

# Test QtWarningFilter class directly
print("\n7. Testing QtWarningFilter class:")
filter_obj = qtlog.QtWarningFilter("Pattern")
record = logging.LogRecord(
    name='test',
    level=logging.WARNING,
    pathname='test.py',
    lineno=1,
    msg='Pattern match',
    args=(),
    exc_info=None
)
result = filter_obj.filter(record)
if result == False:  # Should be filtered (return False)
    print("   ✓ QtWarningFilter correctly filters matching patterns")
else:
    print("   ✗ QtWarningFilter did not filter correctly")

record.msg = 'No match'
result = filter_obj.filter(record)
if result == True:  # Should not be filtered (return True)
    print("   ✓ QtWarningFilter correctly allows non-matching patterns")
else:
    print("   ✗ QtWarningFilter did not allow non-matching patterns")

# Verify functions are in qtlog, not in log
print("\n8. Verifying module organization:")
