else:
    print("   ✗ hide_qt_warning is NOT in qtlog")

if hasattr(qtlog, 'QtWarningFilter'):
    print("   ✓ QtWarningFilter is in qtlog")
else:
    print("   ✗ QtWarningFilter is NOT in qtlog")

if not hasattr(log, 'hide_qt_warning'):
    print("   ✓ hide_qt_warning is NOT in log")
else:
    print("   ✗ hide_qt_warning is still in log")

if not hasattr(log, 'QtWarningFilter'):
    print("   ✓ QtWarningFilter is NOT in log")
else:
    print("   ✗ QtWarningFilter is still in log")

