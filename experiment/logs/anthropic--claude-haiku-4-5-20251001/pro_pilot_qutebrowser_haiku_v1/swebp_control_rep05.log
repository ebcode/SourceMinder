import logging
import sys
from io import StringIO
from qutebrowser.utils.qtlog import hide_qt_warning, QtWarningFilter

# Create a logger
logger = logging.getLogger('qt')
logger.setLevel(logging.WARNING)

# Create a string buffer to capture log messages
log_capture = StringIO()
handler = logging.StreamHandler(log_capture)
handler.setLevel(logging.WARNING)
formatter = logging.Formatter('%(message)s')
handler.setFormatter(formatter)
logger.addHandler(handler)

# Test 1: Message that should be hidden
print("Test 1: Message that should be hidden")
with hide_qt_warning("test pattern"):
    logger.warning("test pattern: this should be hidden")

output = log_capture.getvalue()
if "test pattern" in output:
    print("FAIL: Message was not hidden")
    sys.exit(1)
else:
    print("PASS: Message was hidden")

# Clear the buffer
log_capture.truncate(0)
log_capture.seek(0)

# Test 2: Message that should be visible
print("\nTest 2: Message that should be visible")
with hide_qt_warning("test pattern"):
    logger.warning("other message: this should be visible")

output = log_capture.getvalue()
if "other message" in output:
    print("PASS: Message was visible")
else:
    print("FAIL: Message was hidden")
    sys.exit(1)

# Clear the buffer
log_capture.truncate(0)
log_capture.seek(0)

# Test 3: Message with leading whitespace
print("\nTest 3: Message with leading whitespace")
with hide_qt_warning("test pattern"):
    logger.warning("  test pattern: this should be hidden")

output = log_capture.getvalue()
if "test pattern" in output:
    print("FAIL: Message with leading whitespace was not hidden")
    sys.exit(1)
else:
    print("PASS: Message with leading whitespace was hidden")

# Clear the buffer
log_capture.truncate(0)
log_capture.seek(0)

# Test 4: Message that exactly matches the pattern
print("\nTest 4: Message that exactly matches the pattern")
with hide_qt_warning("test pattern"):
    logger.warning("test pattern")

output = log_capture.getvalue()
if "test pattern" in output:
    print("FAIL: Message that exactly matches the pattern was not hidden")
    sys.exit(1)
else:
    print("PASS: Message that exactly matches the pattern was hidden")

print("\nAll tests passed!")
EOF
</parameter>
</invoke>
</function_calls>

