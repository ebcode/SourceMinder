        case bytes.HasPrefix(in, tlsPrefix):
                return ProtoTLS, nil
        case isHTTP(in):
                return ProtoHTTP, nil
        case bytes.HasPrefix(in, postgresSSLRequest), bytes.HasPrefix(in, 
postgresCancelRequest):
                return ProtoPostgres, nil
        default:
                return ProtoUnknown, trace.BadParameter("multiplexer failed to 
detect connection protocol, first few bytes were: %#v", in)
        }
}
