// Simplified version of the ReadProxyLineV2 function for testing
func TestProxyV2Parsing() {
        // Create a buffer with the proxy protocol v2 header
        data := []byte{
                0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 
0x54, 0x0A, //signature
                0x21, 0x11, //version/command, family
                0x00, 12, //address length
                0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1
                0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1
                0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 
9000
        }

        reader := bufio.NewReader(bytes.NewReader(data))

        // Read signature
        signature := make([]byte, 12)
        reader.Read(signature)
        fmt.Printf("Signature: %v\n", signature)

        // Read version/command
        versionCommand := make([]byte, 1)
        reader.Read(versionCommand)
        fmt.Printf("Version/Command: 0x%02x\n", versionCommand[0])

        // Read family/protocol
        familyProtocol := make([]byte, 1)
        reader.Read(familyProtocol)
        fmt.Printf("Family/Protocol: 0x%02x\n", familyProtocol[0])

        // Read address length
        lengthBytes := make([]byte, 2)
        reader.Read(lengthBytes)
        addressLength := int(lengthBytes[0])<<8 | int(lengthBytes[1])
        fmt.Printf("Address Length: %d\n", addressLength)

        // Read addresses and ports
        addressData := make([]byte, addressLength)
        reader.Read(addressData)

        // Parse source IP
        sourceIP := net.IPv4(addressData[0], addressData[1], addressData[2], 
addressData[3])
        fmt.Printf("Source IP: %s\n", sourceIP.String())

        // Parse destination IP
        destIP := net.IPv4(addressData[4], addressData[5], addressData[6], 
addressData[7])
        fmt.Printf("Destination IP: %s\n", destIP.String())

        // Parse source port
        sourcePort := int(addressData[8])<<8 | int(addressData[9])
        fmt.Printf("Source Port: %d\n", sourcePort)

        // Parse destination port
        destPort := int(addressData[10])<<8 | int(addressData[11])
        fmt.Printf("Destination Port: %d\n", destPort)

        fmt.Printf("\nExpected: 127.0.0.1:8000\n")
        fmt.Printf("Got: %s:%d\n", sourceIP.String(), sourcePort)
}

func main() {
        TestProxyV2Parsing()
}
EOF
