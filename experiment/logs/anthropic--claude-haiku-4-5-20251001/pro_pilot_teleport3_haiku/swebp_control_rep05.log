package main

import (
        "bufio"
        "bytes"
        "fmt"
)

func main() {
        // Test data from the test case
        data := []byte{
                0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 
0x54, 0x0A, //signature
                0x21, 0x11, //version/command, family
                0x00, 12, //address length
                0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1
                0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1
                0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 
9000
        }

        reader := bufio.NewReader(bytes.NewReader(data))
        
        // Peek first 3 bytes
        peeked, _ := reader.Peek(3)
        fmt.Printf("First 3 bytes: %#v\n", peeked)
        
        // Expected signature first 3 bytes
        expectedSig := []byte{0x0D, 0x0A, 0x0D}
        fmt.Printf("Expected first 3 bytes: %#v\n", expectedSig)
        fmt.Printf("Match: %v\n", bytes.HasPrefix(peeked, expectedSig))
}
EOF
go run /tmp/test_proxy_v2.go
```

