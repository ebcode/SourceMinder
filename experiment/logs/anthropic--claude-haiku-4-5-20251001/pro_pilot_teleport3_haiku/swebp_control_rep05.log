// ReadProxyLineV2 reads proxy line protocol v2 from the reader
// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
        // Read the 12-byte signature
        signature := make([]byte, 12)
        _, err := io.ReadFull(reader, signature)
        if err != nil {
                return nil, trace.Wrap(err)
        }

        // Verify the signature
        expectedSignature := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 
0x51, 0x55, 0x49, 0x54, 0x0A}
        if !bytes.Equal(signature, expectedSignature) {
                return nil, trace.BadParameter("invalid proxy protocol v2 
signature")
        }

        // Read version/command byte
        versionCommand := make([]byte, 1)
        _, err = io.ReadFull(reader, versionCommand)
        if err != nil {
                return nil, trace.Wrap(err)
        }

        // Read family byte
        family := make([]byte, 1)
        _, err = io.ReadFull(reader, family)
        if err != nil {
                return nil, trace.Wrap(err)
        }

        // Only support TCP over IPv4 (0x11)
        if family[0] != 0x11 {
                return nil, trace.BadParameter("unsupported address family: 
%#x", family[0])
        }

        // Read address length (2 bytes, big-endian)
        lengthBytes := make([]byte, 2)
        _, err = io.ReadFull(reader, lengthBytes)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        addressLength := binary.BigEndian.Uint16(lengthBytes)

        // For TCP over IPv4, we expect 12 bytes (4 + 4 + 2 + 2)
        if addressLength < 12 {
                return nil, trace.BadParameter("invalid address length for TCP 
over IPv4: %d", addressLength)
        }

        // Read source IP (4 bytes)
        sourceIP := make([]byte, 4)
        _, err = io.ReadFull(reader, sourceIP)
        if err != nil {
                return nil, trace.Wrap(err)
        }

        // Read destination IP (4 bytes)
        destIP := make([]byte, 4)
        _, err = io.ReadFull(reader, destIP)
        if err != nil {
                return nil, trace.Wrap(err)
        }

        // Read source port (2 bytes, big-endian)
        sourcePortBytes := make([]byte, 2)
        _, err = io.ReadFull(reader, sourcePortBytes)
        if err != nil {
