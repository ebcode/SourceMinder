package main

import (
        "bufio"
        "bytes"
        "encoding/binary"
        "fmt"
        "net"
)

// Simulate the ReadProxyLineV2 function
func testProxyV2() {
        // Create a buffer with the proxy protocol v2 header
        buf := new(bytes.Buffer)
        
        // Write signature
        buf.Write([]byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 
0x49, 0x54, 0x0A})
        
        // Write version/command (0x21 = PROXY command, version 2)
        buf.WriteByte(0x21)
        
        // Write family (0x11 = TCP over IPv4)
        buf.WriteByte(0x11)
        
        // Write address length (12 bytes for TCP4)
        binary.Write(buf, binary.BigEndian, uint16(12))
        
        // Write source IP (127.0.0.1)
        buf.Write([]byte{0x7F, 0x00, 0x00, 0x01})
        
        // Write destination IP (127.0.0.1)
        buf.Write([]byte{0x7F, 0x00, 0x00, 0x01})
        
        // Write source port (8000)
        binary.Write(buf, binary.BigEndian, uint16(8000))
        
        // Write destination port (9000)
        binary.Write(buf, binary.BigEndian, uint16(9000))
        
        // Verify the buffer
        data := buf.Bytes()
        fmt.Printf("Generated proxy v2 header (%d bytes):\n", len(data))
        fmt.Printf("Hex: %v\n", data)
        
        // Verify signature
        expectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 
0x55, 0x49, 0x54, 0x0A}
        if bytes.Equal(data[:12], expectedSig) {
                fmt.Println("✓ Signature matches")
        } else {
                fmt.Println("✗ Signature mismatch")
        }
        
        // Verify version/command
        if data[12] == 0x21 {
                fmt.Println("✓ Version/command correct (0x21)")
        }
        
        // Verify family
        if data[13] == 0x11 {
                fmt.Println("✓ Family correct (0x11 = TCP4)")
        }
        
        // Verify address length
        addrLen := binary.BigEndian.Uint16(data[14:16])
        if addrLen == 12 {
                fmt.Println("✓ Address length correct (12)")
        }
        
        // Verify source IP
        sourceIP := net.IPv4(data[16], data[17], data[18], data[19])
        fmt.Printf("✓ Source IP: %s\n", sourceIP.String())
        
        // Verify destination IP
        destIP := net.IPv4(data[20], data[21], data[22], data[23])
        fmt.Printf("✓ Destination IP: %s\n", destIP.String())
        
        // Verify source port
        sourcePort := binary.BigEndian.Uint16(data[24:26])
        fmt.Printf("✓ Source port: %d\n", sourcePort)
        
        // Verify destination port
        destPort := binary.BigEndian.Uint16(data[26:28])
        fmt.Printf("✓ Destination port: %d\n", destPort)
}

func main() {
        testProxyV2()
}
EOF
