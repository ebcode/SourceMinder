// ProxyLineV2 related constants and functions for HAProxy Proxy Protocol v2
// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt

var (
        // proxyV2Prefix is the 12-byte signature for PROXY protocol v2
        proxyV2Prefix = []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 
0x55, 0x49, 0x54, 0x0A}
)

const (
        // proxyV2VersionCommand is the version and command byte for PROXY 
protocol v2
        // 0x2X where X is the command (1 = PROXY, 0 = LOCAL)
        proxyV2VersionCommand = 0x21

        // proxyV2FamilyTCP4 is the family byte for TCP over IPv4
        proxyV2FamilyTCP4 = 0x11
)

// ReadProxyLineV2 reads a PROXY protocol v2 header from the given buffered 
reader
func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
        // Read the 12-byte signature
        sig := make([]byte, 12)
        n, err := reader.Read(sig)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 12 {
                return nil, trace.BadParameter("failed to read proxy v2 
signature, got %d bytes", n)
        }
        if !bytes.Equal(sig, proxyV2Prefix) {
                return nil, trace.BadParameter("invalid proxy v2 signature")
        }

        // Read version/command and family bytes
        versionCommand := make([]byte, 1)
        n, err = reader.Read(versionCommand)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 1 {
                return nil, trace.BadParameter("failed to read version/command 
byte")
        }

        family := make([]byte, 1)
        n, err = reader.Read(family)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 1 {
                return nil, trace.BadParameter("failed to read family byte")
        }

        // Only support PROXY command (0x21) with TCP over IPv4 (0x11)
        if versionCommand[0] != proxyV2VersionCommand {
                return nil, trace.BadParameter("unsupported proxy v2 
version/command: %#x", versionCommand[0])
        }
        if family[0] != proxyV2FamilyTCP4 {
                return nil, trace.BadParameter("unsupported proxy v2 family: 
%#x", family[0])
        }

        // Read address length (2 bytes, big-endian)
        lenBytes := make([]byte, 2)
        n, err = reader.Read(lenBytes)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 2 {
                return nil, trace.BadParameter("failed to read address length")
        }
        addrLen := int(lenBytes[0])<<8 | int(lenBytes[1])

        // For TCP4, we expect 12 bytes: 4 bytes source IP + 4 bytes dest IP + 2
bytes source port + 2 bytes dest port
        if addrLen != 12 {
                return nil, trace.BadParameter("invalid address length for TCP4:
%d", addrLen)
        }

        // Read addresses and ports
        addrData := make([]byte, addrLen)
        n, err = reader.Read(addrData)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != addrLen {
                return nil, trace.BadParameter("failed to read address data, 
expected %d bytes, got %d", addrLen, n)
        }

        // Parse source IP (first 4 bytes)
        sourceIP := net.IPv4(addrData[0], addrData[1], addrData[2], addrData[3])
        if sourceIP == nil {
                return nil, trace.BadParameter("failed to parse source IP")
        }

        // Parse destination IP (next 4 bytes)
        destIP := net.IPv4(addrData[4], addrData[5], addrData[6], addrData[7])
        if destIP == nil {
                return nil, trace.BadParameter("failed to parse destination IP")
        }

        // Parse source port (next 2 bytes, big-endian)
        sourcePort := int(addrData[8])<<8 | int(addrData[9])

        // Parse destination port (last 2 bytes, big-endian)
        destPort := int(addrData[10])<<8 | int(addrData[11])

        return &ProxyLine{
                Protocol:    TCP4,
                Source:      net.TCPAddr{IP: sourceIP, Port: sourcePort},
                Destination: net.TCPAddr{IP: destIP, Port: destPort},
        }, nil
}
EOF
```

