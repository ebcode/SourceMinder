package main

import (
        "bufio"
        "bytes"
        "fmt"
        "net"
)

// Minimal test to verify the proxy v2 parsing
func main() {
        // Create the proxy v2 header from the test
        header := []byte{
                0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 
0x54, 0x0A, //signature
                0x21, 0x11, //version/command, family
                0x00, 12, //address length
                0x7F, 0x00, 0x00, 0x01, //source address: 127.0.0.1
                0x7F, 0x00, 0x00, 0x01, //destination address: 127.0.0.1
                0x1F, 0x40, 0x23, 0x28, //source port: 8000, destination port: 
9000
        }

        reader := bufio.NewReader(bytes.NewReader(header))
        
        // Read signature
        sig := make([]byte, 12)
        n, _ := reader.Read(sig)
        fmt.Printf("Signature read: %d bytes\n", n)
        fmt.Printf("Signature: %v\n", sig)
        
        // Read version/command
        vc := make([]byte, 1)
        reader.Read(vc)
        fmt.Printf("Version/Command: %#x\n", vc[0])
        
        // Read family
        fam := make([]byte, 1)
        reader.Read(fam)
        fmt.Printf("Family: %#x\n", fam[0])
        
        // Read address length
        lenBytes := make([]byte, 2)
        reader.Read(lenBytes)
        addrLen := int(lenBytes[0])<<8 | int(lenBytes[1])
        fmt.Printf("Address length: %d\n", addrLen)
        
        // Read addresses and ports
        addrData := make([]byte, addrLen)
        reader.Read(addrData)
        
        // Parse source IP
        sourceIP := net.IPv4(addrData[0], addrData[1], addrData[2], addrData[3])
        fmt.Printf("Source IP: %s\n", sourceIP.String())
        
        // Parse destination IP
        destIP := net.IPv4(addrData[4], addrData[5], addrData[6], addrData[7])
        fmt.Printf("Destination IP: %s\n", destIP.String())
        
        // Parse source port
        sourcePort := int(addrData[8])<<8 | int(addrData[9])
        fmt.Printf("Source port: %d\n", sourcePort)
        
        // Parse destination port
        destPort := int(addrData[10])<<8 | int(addrData[11])
        fmt.Printf("Destination port: %d\n", destPort)
        
        fmt.Printf("\nExpected source: 127.0.0.1:8000\n")
        fmt.Printf("Actual source: %s:%d\n", sourceIP.String(), sourcePort)
}
EOF

cd /tmp && go run test_proxy_v2.go
```

