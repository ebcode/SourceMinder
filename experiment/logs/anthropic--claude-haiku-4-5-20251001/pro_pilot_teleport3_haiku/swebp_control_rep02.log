cat >> /app/lib/multiplexer/proxyline.go << 'EOF'

// ReadProxyLineV2 reads proxy line protocol version 2 from the reader
// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
        // Read the 12-byte signature
        signature := make([]byte, 12)
        n, err := reader.Read(signature)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 12 {
                return nil, trace.BadParameter("failed to read proxy protocol v2
signature")
        }

        // Verify the signature
        expectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 
0x55, 0x49, 0x54, 0x0A}
        if !bytes.Equal(signature, expectedSig) {
                return nil, trace.BadParameter("invalid proxy protocol v2 
signature")
        }

        // Read version/command byte
        versionCmd := make([]byte, 1)
        n, err = reader.Read(versionCmd)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 1 {
                return nil, trace.BadParameter("failed to read version/command 
byte")
        }

        // Read family byte
        family := make([]byte, 1)
        n, err = reader.Read(family)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 1 {
                return nil, trace.BadParameter("failed to read family byte")
        }

        // Read address length (2 bytes, big-endian)
        lenBytes := make([]byte, 2)
        n, err = reader.Read(lenBytes)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != 2 {
                return nil, trace.BadParameter("failed to read address length")
        }
        addrLen := int(lenBytes[0])<<8 | int(lenBytes[1])

        // Read the addresses and ports
        addrData := make([]byte, addrLen)
        n, err = reader.Read(addrData)
        if err != nil {
                return nil, trace.Wrap(err)
        }
        if n != addrLen {
                return nil, trace.BadParameter("failed to read address data")
        }

        // Parse based on family
        // 0x11 = TCP over IPv4
        if family[0] == 0x11 {
                if addrLen < 12 {
                        return nil, trace.BadParameter("invalid address length 
for TCP4")
                }

                // Extract source and destination IPs and ports
                sourceIP := net.IPv4(addrData[0], addrData[1], addrData[2], 
addrData[3])
                destIP := net.IPv4(addrData[4], addrData[5], addrData[6], 
addrData[7])
                sourcePort := int(addrData[8])<<8 | int(addrData[9])
                destPort := int(addrData[10])<<8 | int(addrData[11])

                return &ProxyLine{
                        Protocol:    TCP4,
                        Source:      net.TCPAddr{IP: sourceIP, Port: 
sourcePort},
                        Destination: net.TCPAddr{IP: destIP, Port: destPort},
                }, nil
        }

        return nil, trace.BadParameter("unsupported proxy protocol v2 family: 
%d", family[0])
}
EOF
