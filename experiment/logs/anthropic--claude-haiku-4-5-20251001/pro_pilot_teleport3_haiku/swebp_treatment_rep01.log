// Simplified test to verify the proxy protocol v2 parsing
func main() {
        // Create a proxy protocol v2 header
        header := []byte{
                0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 
0x54, 0x0A, // signature
                0x21, 0x11, // version/command, family
                0x00, 12, // address length
                0x7F, 0x00, 0x00, 0x01, // source address: 127.0.0.1
                0x7F, 0x00, 0x00, 0x01, // destination address: 127.0.0.1
                0x1F, 0x40, 0x23, 0x28, // source port: 8000, destination port: 
9000
        }

        reader := bufio.NewReader(bytes.NewReader(header))

        // Verify the signature
        sig := make([]byte, 12)
        reader.Read(sig)
        expectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 
0x55, 0x49, 0x54, 0x0A}
        if bytes.Equal(sig, expectedSig) {
                fmt.Println("✓ Signature validation passed")
        } else {
                fmt.Println("✗ Signature validation failed")
        }

        // Read version/command and family
        vc := make([]byte, 1)
        reader.Read(vc)
        fmt.Printf("✓ Version/Command: 0x%02x\n", vc[0])

        fam := make([]byte, 1)
        reader.Read(fam)
        fmt.Printf("✓ Family: 0x%02x (TCP4)\n", fam[0])

        // Read address length
        lenBytes := make([]byte, 2)
        reader.Read(lenBytes)
        addrLen := int(lenBytes[0])<<8 | int(lenBytes[1])
        fmt.Printf("✓ Address length: %d\n", addrLen)

        // Read addresses
        addrs := make([]byte, addrLen)
        reader.Read(addrs)
        sourceIP := net.IPv4(addrs[0], addrs[1], addrs[2], addrs[3])
        destIP := net.IPv4(addrs[4], addrs[5], addrs[6], addrs[7])
        sourcePort := int(addrs[8])<<8 | int(addrs[9])
        destPort := int(addrs[10])<<8 | int(addrs[11])

        fmt.Printf("✓ Source IP: %s:%d\n", sourceIP.String(), sourcePort)
        fmt.Printf("✓ Destination IP: %s:%d\n", destIP.String(), destPort)

        if sourceIP.String() == "127.0.0.1" && sourcePort == 8000 {
                fmt.Println("\n✓ All proxy protocol v2 parsing tests passed!")
        }
}
EOF

