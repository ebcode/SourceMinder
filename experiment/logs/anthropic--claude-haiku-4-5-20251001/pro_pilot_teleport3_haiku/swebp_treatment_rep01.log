+// ReadProxyLineV2 reads proxy line protocol version 2 from the reader
+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
+       // Read the 12-byte signature
+       signature := make([]byte, 12)
+       _, err := reader.Read(signature)
+       if err != nil {
+               return nil, trace.Wrap(err)
+       }
+
+       // Validate the signature
+       expectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 
0x55, 0x49, 0x54, 0x0A}
+       if !bytes.Equal(signature, expectedSig) {
+               return nil, trace.BadParameter("invalid proxy protocol v2 
signature")
+       }
+
+       // Read version/command byte and protocol family byte
+       versionCommand := make([]byte, 1)
+       _, err = reader.Read(versionCommand)
+       if err != nil {
+               return nil, trace.Wrap(err)
+       }
+
+       family := make([]byte, 1)
+       _, err = reader.Read(family)
+       if err != nil {
+               return nil, trace.Wrap(err)
+       }
+
+       // Read address length (2 bytes, big-endian)
+       lenBytes := make([]byte, 2)
+       _, err = reader.Read(lenBytes)
+       if err != nil {
+               return nil, trace.Wrap(err)
+       }
+       addrLen := int(lenBytes[0])<<8 | int(lenBytes[1])
+
+       // Read the addresses and ports
+       addresses := make([]byte, addrLen)
+       _, err = reader.Read(addresses)
+       if err != nil {
+               return nil, trace.Wrap(err)
+       }
+
+       // Parse based on protocol family
+       // 0x11 = TCP over IPv4
+       if family[0] != 0x11 {
+               return nil, trace.BadParameter("unsupported protocol family: 
%#x", family[0])
+       }
+
+       // For TCP4, we expect 12 bytes: 4 bytes source IP + 4 bytes dest IP + 2
bytes source port + 2 bytes dest port
+       if addrLen != 12 {
+               return nil, trace.BadParameter("invalid address length for TCP4:
%d", addrLen)
+       }
+
+       sourceIP := net.IPv4(addresses[0], addresses[1], addresses[2], 
addresses[3])
+       destIP := net.IPv4(addresses[4], addresses[5], addresses[6], 
addresses[7])
+       sourcePort := int(addresses[8])<<8 | int(addresses[9])
+       destPort := int(addresses[10])<<8 | int(addresses[11])
+
+       ret := ProxyLine{
+               Protocol:    TCP4,
+               Source:      net.TCPAddr{IP: sourceIP, Port: sourcePort},
+               Destination: net.TCPAddr{IP: destIP, Port: destPort},
+       }
+
