        # No CLIXML header found
        return stderr
    
    # Find the start of the XML content (after the header)
    xml_start = header_idx + len(header)
    
    # Find the <Objs tag
    objs_start = stderr.find(b"<Objs ", xml_start)
    if objs_start == -1:
        # No <Objs tag found
        return stderr
    
    # Find the closing </Objs> tag
    objs_end = stderr.find(b"</Objs>", objs_start)
    if objs_end == -1:
        # No closing tag found
        return stderr
    
    # Include the closing tag
    objs_end += len(b"</Objs>")
    
    # Extract the CLIXML block (from header to end of </Objs>)
    clixml_block = stderr[header_idx:objs_end]
    
    # Try to decode the CLIXML block as UTF-8, fall back to cp437
    try:
        clixml_text = clixml_block.decode('utf-8')
    except UnicodeDecodeError:
