# So the string "_x\u6100\u6200\u6300\u6400_" when encoded as UTF-16-BE is:
test_str = "_x\u6100\u6200\u6300\u6400_"
test_bytes = test_str.encode("utf-16-be")
print("\nTest string:", test_str)
print("Test bytes (UTF-16-BE):", test_bytes)
print("Test bytes (hex):", test_bytes.hex())

# Now let's see what the regex matches
