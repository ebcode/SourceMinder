correct = rb"\x00_\x00x([\x00a-fA-F0-9]{8})\x00_"

pattern1 = re.compile(current)
pattern2 = re.compile(correct)

match1 = pattern1.search(test_bytes)
match2 = pattern2.search(test_bytes)

print("\nCurrent regex matches:", match1 is not None)
if match1:
    print("  Match:", match1.group(0))
    print("  Group 1:", match1.group(1))

print("Correct regex matches:", match2 is not None)
if match2:
    print("  Match:", match2.group(0))
    print("  Group 1:", match2.group(1))

# The issue is that \u6100 in UTF-16-BE is \x61\x00
# So the pattern \x00_\x00x matches \x00_ and \x00x
# But then we need 8 bytes that are either \x00 or hex chars
# The bytes are: \x61\x00\x62\x00\x63\x00\x64\x00
# These are: a\x00b\x00c\x00d\x00
# So the pattern matches because 'a', 'b', 'c', 'd' are hex chars!

# The problem is that the regex is matching valid Unicode characters
# that happen to look like hex when encoded as UTF-16-BE

# The fix is to ensure we only match actual _xHHHH_ sequences
# which would be encoded as \x00_\x00x\x00H\x00H\x00H\x00H\x00_
# where H is a hex digit (0-9, a-f, A-F)

# So the correct regex should match:
# \x00_\x00x followed by 8 bytes where each pair is \x00 followed by a hex digit
# This would be: \x00_\x00x(\x00[0-9a-fA-F]){4}\x00_

correct_regex = rb"\x00_\x00x(\x00[0-9a-fA-F]){4}\x00_"
pattern3 = re.compile(correct_regex)

match3 = pattern3.search(test_bytes)
print("\nCorrected regex matches unicode test:", match3 is not None)

