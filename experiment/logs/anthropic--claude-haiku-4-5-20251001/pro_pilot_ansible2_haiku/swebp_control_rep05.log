import re
import xml.etree.ElementTree as ET
from ansible.module_utils.common.text.converters import to_bytes

def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML blocks in stderr with their decoded content.
    
    Scans stderr line by line for CLIXML headers (b"\r\nCLIXML\r\n" or starting 
with b"#< CLIXML\r\n").
    When a CLIXML block is found, it attempts to parse it and replace it with 
the decoded content.
    If parsing fails or the block is incomplete, the original data is returned 
unchanged.
    
    Non-UTF-8 data is decoded with cp437 fallback before re-encoding to UTF-8.
    """
    
    # If no CLIXML header, return unchanged
    if b"#< CLIXML" not in stderr:
        return stderr
    
    # Split by lines to find CLIXML headers
    lines = stderr.split(b"\r\n")
    result = []
    i = 0
    
    while i < len(lines):
        line = lines[i]
        
        # Check if this line starts with CLIXML header
        if line.startswith(b"#< CLIXML"):
            # Found a CLIXML header, try to find the complete block
            # The block should contain <Objs ...></Objs>
            
            # Collect lines until we find </Objs>
            clixml_lines = [line]
            j = i + 1
            found_end = False
            
            while j < len(lines):
                clixml_lines.append(lines[j])
                if b"</Objs>" in lines[j]:
                    found_end = True
                    break
                j += 1
            
            if not found_end:
                # Incomplete CLIXML block, return original
                result.append(line)
                i += 1
                continue
            
            # Try to parse the CLIXML block
            clixml_data = b"\r\n".join(clixml_lines)
            
            try:
                # Try to parse with _parse_clixml
                from ansible.plugins.shell.powershell import _parse_clixml
                decoded = _parse_clixml(clixml_data)
                
                # If we got here, parsing succeeded
                # Replace the CLIXML block with the decoded content
                result.append(decoded)
                
                # Move past the CLIXML block
                i = j + 1
                
            except Exception:
                # Parsing failed, return original
                result.append(line)
                i += 1
                continue
        else:
            result.append(line)
            i += 1
    
    return b"\r\n".join(result)

