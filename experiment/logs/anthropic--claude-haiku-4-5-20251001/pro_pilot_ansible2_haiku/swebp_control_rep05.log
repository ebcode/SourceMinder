actual_escape = "_x0061_".encode("utf-16-be")
print("\nActual escape _x0061_ (UTF-16-BE):", actual_escape)
print("Actual escape (hex):", actual_escape.hex())

match3_actual = pattern3.search(actual_escape)
print("Corrected regex matches actual escape:", match3_actual is not None)
if match3_actual:
    print("  Match:", match3_actual.group(0))

