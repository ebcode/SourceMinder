    import xml.etree.ElementTree as ET
    
    # Look for CLIXML header
    clixml_header = b"\r\nCLIXML\r\n"
    
    # Check if there's a CLIXML header at the start (without leading \r\n)
    if stderr.startswith(b"#< CLIXML\r\n"):
        # Try to find the end of the CLIXML block
        start_idx = 0
        # Find the <Objs tag
        objs_start = stderr.find(b"<Objs ")
        if objs_start != -1:
            # Find the closing </Objs> tag
            objs_end = stderr.find(b"</Objs>")
            if objs_end != -1:
                objs_end += 7  # Include the closing tag
                
                # Try to parse the CLIXML
