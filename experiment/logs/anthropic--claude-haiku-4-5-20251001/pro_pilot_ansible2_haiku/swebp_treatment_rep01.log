                    clixml_block = stderr[objs_start:objs_end]
                    # Try to decode and parse
                    try:
                        decoded = _parse_clixml(stderr[:objs_end])
                    except Exception:
                        # If parsing fails, return original
                        return stderr
                    
                    # Get any remaining data after the CLIXML block
                    remaining = stderr[objs_end:]
                    
                    # Return the decoded content + remaining data
                    return decoded + remaining
                except Exception:
                    # If anything fails, return original
                    return stderr
    
    # Check for CLIXML header in the middle of the data
    # Look for lines that contain the CLIXML header
    lines = stderr.split(b"\r\n")
    result = []
