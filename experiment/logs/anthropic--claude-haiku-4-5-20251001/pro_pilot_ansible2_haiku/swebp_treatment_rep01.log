        if b"#< CLIXML" in line:
            # Find the position of the header in the line
            header_pos = line.find(b"#< CLIXML")
            
            # Add any content before the header
            if header_pos > 0:
                result.append(line[:header_pos])
            
            # Now we need to find the complete CLIXML block
            # It should start with <Objs and end with </Objs>
            clixml_data = b""
            j = i
            found_objs_start = False
            found_objs_end = False
            
