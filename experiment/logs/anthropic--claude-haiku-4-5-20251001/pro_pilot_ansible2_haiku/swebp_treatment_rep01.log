                        clixml_data = current_line[objs_pos:]
                        j += 1
                        continue
                
                if found_objs_start and not found_objs_end:
                    objs_end_pos = current_line.find(b"</Objs>")
                    if objs_end_pos != -1:
                        found_objs_end = True
                        clixml_data += current_line[:objs_end_pos + 7]
                        
                        # Try to parse the CLIXML
                        try:
                            # Reconstruct the full CLIXML with header
                            full_clixml = b"#< CLIXML\r\n" + clixml_data
                            decoded = _parse_clixml(full_clixml)
                            result.append(decoded)
                            
                            # Add any remaining content on this line
                            remaining_on_line = current_line[objs_end_pos + 7:]
                            if remaining_on_line:
                                result.append(remaining_on_line)
                        except Exception:
                            # If parsing fails, add the original CLIXML data
                            result.append(b"#< CLIXML\r\n" + clixml_data)
                            remaining_on_line = current_line[objs_end_pos + 7:]
                            if remaining_on_line:
                                result.append(remaining_on_line)
                        
                        i = j
                        break
                    else:
                        clixml_data += current_line + b"\r\n"
                        j += 1
                else:
                    j += 1
            
            if not found_objs_end:
                # CLIXML block is incomplete, return original
                return stderr
        else:
            result.append(line)
        
        i += 1
    
    # Join the result back together
    return b"\r\n".join(result)

