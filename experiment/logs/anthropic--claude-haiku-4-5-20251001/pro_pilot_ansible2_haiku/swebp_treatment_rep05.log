def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML-encoded blocks in stderr with their decoded text content.
    
    Scans stderr line by line for CLIXML headers and replaces any valid CLIXML
    blocks with their decoded content. Non-CLIXML content is preserved 
unchanged.
    
