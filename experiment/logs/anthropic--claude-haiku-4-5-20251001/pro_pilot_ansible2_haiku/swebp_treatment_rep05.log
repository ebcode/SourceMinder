function_code = '''
def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML-encoded blocks in stderr with their decoded text content.
    
    Scans stderr for CLIXML blocks and replaces any valid CLIXML blocks with
    their decoded content. Non-CLIXML content is preserved unchanged.
    
    Handles UTF-8 decoding with cp437 fallback for non-UTF-8 data.
    
    Args:
        stderr: The stderr bytes to process
        
    Returns:
        The stderr bytes with CLIXML blocks replaced by decoded text
    """
    if not stderr:
        return stderr
    
    # Look for CLIXML header pattern - it should be on its own line
    # The pattern is: <preceding content>\\r\\n#< CLIXML\\r\\n<XML 
content></Objs>
    
    # First, check if there's any CLIXML header
    if b"#< CLIXML" not in stderr:
        return stderr
    
    result = bytearray()
    i = 0
    
    while i < len(stderr):
        # Look for CLIXML header
        if stderr[i:i+9] == b"#< CLIXML":
            # Found a potential CLIXML block
            # The header should be followed by \\r\\n
            header_end = i + 9
            if header_end + 2 <= len(stderr) and stderr[header_end:header_end+2]
== b"\\r\\n":
                xml_start = header_end + 2
                
                # Look for the closing tag </Objs>
                xml_end = stderr.find(b"</Objs>", xml_start)
                if xml_end != -1:
                    xml_end += 7  # Include the closing tag
                    
                    # Check if the CLIXML block is on a single line (no \\r\\n 
between header and </Objs>)
                    clixml_block = stderr[i:xml_end]
                    
                    # Count \\r\\n in the block (should be exactly 1 - the one 
after the header)
                    newline_count = clixml_block.count(b"\\r\\n")
                    
                    if newline_count == 1:
                        # This is a valid single-line CLIXML block
                        try:
                            # Try to decode the CLIXML block as UTF-8
                            try:
                                clixml_block.decode('utf-8')
                            except UnicodeDecodeError:
                                # If UTF-8 fails, try cp437 and re-encode as 
UTF-8
                                clixml_block = 
clixml_block.decode('cp437').encode('utf-8')
                            
                            decoded = _parse_clixml(clixml_block)
                            # Successfully parsed, add the decoded content
                            result.extend(decoded)
                            i = xml_end
                            continue
                        except Exception:
                            # Failed to parse, keep the original data
                            pass
        
        # No valid CLIXML found at this position, just copy the byte
        result.append(stderr[i])
        i += 1
    
    return bytes(result)

'''

# Insert the function before the class definition
content = content[:class_idx] + function_code + content[class_idx:]

# Write the file back
with open('/app/lib/ansible/plugins/shell/powershell.py', 'w') as f:
    f.write(content)

print("Function added successfully")
EOF
