@@ -90,6 +90,73 @@ def _parse_clixml(data: bytes, stream: str = "Error") -> 
bytes:
 
     return to_bytes(''.join(lines), errors="surrogatepass")
 
+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """
+    Replace CLIXML blocks in stderr with their decoded content.
+    
+    Scans stderr for CLIXML headers and replaces any complete CLIXML blocks
+    with their decoded text. Non-CLIXML content is preserved.
+    Falls back to cp437 decoding if UTF-8 fails.
+    """
+    if not stderr:
+        return stderr
+    
+    # Look for CLIXML header
+    clixml_header = b"#< CLIXML\r\n"
+    header_idx = stderr.find(clixml_header)
+    
+    if header_idx == -1:
+        return stderr
+    
+    # Find the start of the XML content (after the header)
+    xml_start = header_idx + len(clixml_header)
+    
+    # Find the closing </Objs> tag
+    objs_end = stderr.find(b"</Objs>", xml_start)
+    
+    if objs_end == -1:
+        # No closing tag found, return original
+        return stderr
+    
+    # Extract the XML content (between header and </Objs>)
+    xml_content = stderr[xml_start:objs_end + 7]  # 7 is len("</Objs>")
+    
+    # Check if the XML content spans multiple lines
+    # The XML content should not contain \r\n (it should be on a single line)
