import re
import base64
import xml.etree.ElementTree as ET

def _parse_clixml(data: bytes, stream: str = "Error") -> bytes:
    """
    Takes a byte string like '#< CLIXML\r\n<Objs...' and extracts the stream
    message encoded in the XML data. CLIXML is used by PowerShell to encode
    multiple objects in stderr.
    """
    lines = []

    def rplcr(matchobj):
        match_hex = matchobj.group(1)
        hex_string = match_hex.decode("utf-16-be")
        return base64.b16decode(hex_string.upper())

    _STRING_DESERIAL_FIND = 
re.compile(rb"\x00_\x00x((?:\x00[0-9a-fA-F]){4})\x00_")

    while data:
        start_idx = data.find(b"<Objs ")
        end_idx = data.find(b"</Objs>")
        if start_idx == -1 or end_idx == -1:
            break

        end_idx += 7
        current_element = data[start_idx:end_idx]
        data = data[end_idx:]

        clixml = ET.fromstring(current_element)
        namespace_match = re.match(r'{(.*)}', clixml.tag)
        namespace = f"{{{namespace_match.group(1)}}}" if namespace_match else ""

        entries = clixml.findall("./%sS" % namespace)
        if not entries:
            continue

        if lines:
            lines.append("\r\n")

        for string_entry in entries:
            actual_stream = string_entry.attrib.get('S', None)
            if actual_stream != stream:
                continue

            b_line = (string_entry.text or "").encode("utf-16-be")
            b_escaped = re.sub(_STRING_DESERIAL_FIND, rplcr, b_line)

            lines.append(b_escaped.decode("utf-16-be", errors="surrogatepass"))

    return ''.join(lines).encode('utf-8', errors="surrogatepass")


def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML blocks in stderr with their decoded content.
    
    Scans stderr for CLIXML headers and replaces any complete CLIXML blocks
    with their decoded text. Non-CLIXML content is preserved.
    Falls back to cp437 decoding if UTF-8 fails.
    """
    if not stderr:
        return stderr
    
    # Look for CLIXML header
    clixml_header = b"#< CLIXML\r\n"
    header_idx = stderr.find(clixml_header)
    
    if header_idx == -1:
        return stderr
    
    # Find the start of the XML content (after the header)
    xml_start = header_idx + len(clixml_header)
    
    # Find the closing </Objs> tag
    objs_end = stderr.find(b"</Objs>", xml_start)
    
    if objs_end == -1:
        # No closing tag found, return original
        return stderr
    
    # Extract the XML content (between header and </Objs>)
    xml_content = stderr[xml_start:objs_end + 7]  # 7 is len("</Objs>")
    
    # Check if the XML content spans multiple lines
    # The XML content should not contain \r\n (it should be on a single line)
    if b"\r\n" in xml_content:
        return stderr
    
    # Extract the full CLIXML block
    clixml_block = stderr[header_idx:objs_end + 7]
    
    # Let's try to parse it
    try:
        # Try to decode the CLIXML block
        try:
            decoded = _parse_clixml(clixml_block)
        except Exception:
            # If parsing fails, try with cp437 fallback
            try:
                # Decode as cp437 and re-encode as UTF-8
                clixml_str = clixml_block.decode('cp437', errors='replace')
                clixml_block_utf8 = clixml_str.encode('utf-8', errors='replace')
                decoded = _parse_clixml(clixml_block_utf8)
            except Exception:
                # If all else fails, leave the original data
                raise
        
        # Get any data after the CLIXML block on the same line
        trailing_idx = objs_end + 7
        trailing_data = stderr[trailing_idx:]
        
        # Replace the CLIXML block with decoded content
        result = stderr[:header_idx] + decoded + trailing_data
        return result
    except Exception:
        # If parsing fails, leave the original data
        return stderr


