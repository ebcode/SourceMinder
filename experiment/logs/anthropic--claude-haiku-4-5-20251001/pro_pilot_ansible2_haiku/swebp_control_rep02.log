def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML blocks in stderr with their decoded content.
    
    Scans stderr line by line for CLIXML headers and replaces any complete
    CLIXML blocks with their decoded text. Non-CLIXML content is preserved.
    Falls back to cp437 decoding if UTF-8 fails.
    """
    if not stderr:
        return stderr
    
    # Look for CLIXML header
    clixml_header = b"#< CLIXML\r\n"
    if clixml_header not in stderr:
        return stderr
    
    # Split by lines to find where CLIXML starts
    lines = stderr.split(b"\r\n")
    result = []
    i = 0
    
    while i < len(lines):
        line = lines[i]
        
        # Check if this line contains the CLIXML header
        if line == b"#< CLIXML":
            # Found CLIXML header, now look for the complete block
            # The CLIXML block should start with <Objs and end with </Objs>
            clixml_start = i
            clixml_lines = [line]
            i += 1
            
            # Collect lines until we find </Objs>
            found_end = False
            while i < len(lines):
                clixml_lines.append(lines[i])
                if b"</Objs>" in lines[i]:
                    found_end = True
                    break
                i += 1
            
            if found_end:
                # We have a complete CLIXML block
                clixml_data = b"\r\n".join(clixml_lines)
                
                # Check if there's any data after </Objs> on the same line
                last_line = clixml_lines[-1]
                objs_end_idx = last_line.find(b"</Objs>")
                if objs_end_idx != -1:
                    trailing_data = last_line[objs_end_idx + 7:]  # 7 is 
len("</Objs>")
                else:
                    trailing_data = b""
                
                try:
                    # Try to decode the CLIXML block
                    # First, try UTF-8
                    try:
                        decoded = _parse_clixml(clixml_data)
                    except Exception:
                        # If parsing fails, try with cp437 fallback
                        try:
                            # Decode as cp437 and re-encode as UTF-8
                            clixml_str = clixml_data.decode('cp437', 
errors='replace')
                            clixml_data_utf8 = clixml_str.encode('utf-8', 
errors='replace')
                            decoded = _parse_clixml(clixml_data_utf8)
                        except Exception:
                            # If all else fails, leave the original data
                            raise
                    
                    # Replace the CLIXML block with decoded content
                    result.append(decoded + trailing_data)
                    i += 1
                except Exception:
                    # If parsing fails, leave the original CLIXML block
                    result.append(clixml_data)
                    if trailing_data:
                        result.append(trailing_data)
                    i += 1
            else:
                # Incomplete CLIXML block, leave as is
                result.append(b"\r\n".join(clixml_lines))
                i += 1
        else:
            result.append(line)
            i += 1
    
    return b"\r\n".join(result)

