print()

print("Current regex on invalid:")
print(current.search(invalid_utf16be))
print()

print("Corrected regex on valid:")
print(corrected.search(valid_utf16be))
print()

print("Corrected regex on invalid:")
print(corrected.search(invalid_utf16be))
EOF
