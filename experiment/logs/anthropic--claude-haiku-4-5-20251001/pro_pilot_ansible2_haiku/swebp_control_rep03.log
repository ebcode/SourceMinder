import re
import xml.etree.ElementTree as ET

def _replace_stderr_clixml(stderr: bytes) -> bytes:
    """
    Replace CLIXML blocks in stderr with their decoded content.
    
    Scans stderr line by line for CLIXML headers (b"\r\nCLIXML\r\n" or starting 
with b"#< CLIXML\r\n").
    When found, attempts to parse the CLIXML block and replace it with decoded 
content.
    If parsing fails or CLIXML is incomplete, returns the original data 
unchanged.
    """
    
    # Look for CLIXML header
    clixml_header = b"#< CLIXML\r\n"
    
    # Check if stderr starts with CLIXML header
    if not stderr.startswith(clixml_header):
        # Check if CLIXML appears after some content
        header_idx = stderr.find(b"\r\n" + clixml_header[:-2])  # Find 
\r\nCLIXML\r\n
        if header_idx == -1:
            # No CLIXML found
            return stderr
        # CLIXML found after some content
        start_idx = header_idx + 2  # Skip the \r\n
    else:
        start_idx = 0
    
    # Find the end of the CLIXML block (</Objs>)
    end_marker = b"</Objs>"
    end_idx = stderr.find(end_marker, start_idx)
    
    if end_idx == -1:
        # No closing tag found, return original
        return stderr
    
    end_idx += len(end_marker)
    
    # Extract the CLIXML block
    clixml_block = stderr[start_idx:end_idx]
    
    # Try to parse the CLIXML block
    try:
        # Try to decode as UTF-8 first
        try:
            decoded_content = _parse_clixml(clixml_block)
        except UnicodeDecodeError:
            # Fall back to cp437
            clixml_block_cp437 = clixml_block.decode('cp437').encode('utf-8')
            decoded_content = _parse_clixml(clixml_block_cp437)
    except Exception:
        # If parsing fails, return original
        return stderr
    
    # Replace the CLIXML block with the decoded content
    result = stderr[:start_idx] + decoded_content + stderr[end_idx:]
    
    return result

# Test with a simple example
CLIXML_WITH_ERROR = b'#< CLIXML\r\n<Objs Version="1.1.0.1" 
xmlns="http://schemas.microsoft.com/powershell/2004/04">' \
    b'<S S="Error">My error</S></Objs>'

print("Test 1: CLIXML by itself")
print(f"Input: {CLIXML_WITH_ERROR}")
# This will fail because _parse_clixml is not defined, but we can see the 
structure

EOF
python /tmp/test_implementation.py
