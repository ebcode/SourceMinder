                                                Dialog.message("userUsageDataOpt
InThankYouOptedIn_msg")
                                        } else if (optedIn !== undefined) {
                                                Dialog.message("userUsageDataOpt
InThankYouOptedOut_msg")
                                        }
                                })
                                .then(m.redraw)
                }

                const buttonAttrs: Array<ButtonAttrs> = [
                        {
                                label: "decideLater_action",
                                click: () => closeAction(),
                                type: ButtonType.Secondary,
                        },
                        {
                                label: "deactivate_action",
                                click: () => {
                                        const decision = false
                                        this.usageTestModel.setOptInDecision(dec
ision).then(() => closeAction(decision))
                                },
                                type: ButtonType.Secondary,
                        },
                        {
                                label: "activate_action",
