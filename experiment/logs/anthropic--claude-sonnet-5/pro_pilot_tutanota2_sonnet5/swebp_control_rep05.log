 */
export async function getReferralLink(userController: UserController): 
Promise<string> {
        const customer = await userController.loadCustomer()
        const referralCode = customer.referralCode ? customer.referralCode : 
await requestNewReferralCode()
        return `${getWebRoot()}/signup?ref=${referralCode}`
}

