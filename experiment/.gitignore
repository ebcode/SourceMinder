# Python venv for mini-swe-agent + swebench
.venv/


__pycache__/
# SWE-bench harness report files (run_evaluation writes <model>.<run_id>.json to cwd)
*.qiexp_*.json

# SWE-bench harness per-instance evaluation logs (scratch; not trajectories)
logs/run_evaluation/

# Note: code-index DBs (dbs/*.db) are already covered by the root .gitignore (*.db).
# Analysis outputs (analysis/*.csv) are intentionally NOT ignored — they are the
# experiment's results; commit them when you want to record a pilot/confirmatory run.

# Eval results DB (analysis/eval_results.db, written by eval_db.py): the .db is
# covered by the root *.db ignore, and results are committed via the exported
# analysis/*.csv. Ignore the transient WAL sidecars.
eval_results.db-wal
eval_results.db-shm
